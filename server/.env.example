# === Server dasar ===
PORT=3050
MONGO_URI=mongodb://127.0.0.1:27017/ttslive
# JWT_SECRET=                       # opsional, auto-generate kalau kosong
APP_BASE_URL=https://live.albiontools.fun

# === Google OAuth (BUAT BARU di project TTS-Live V2) ===
# 1. https://console.cloud.google.com/projectcreate  -> "TTS-Live V2"
# 2. APIs & Services > OAuth consent screen > External
# 3. APIs & Services > Credentials > + CREATE > OAuth client ID > Web application
# 4. Authorized redirect URIs:
#    - https://live.albiontools.fun/api/auth/google/callback
#    - http://localhost:3050/api/auth/google/callback
# 5. Authorized JavaScript origins:
#    - https://live.albiontools.fun
#    - http://localhost:3050
GOOGLE_CLIENT_ID=ISI_DARI_GOOGLE_CONSOLE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-ISI_DARI_GOOGLE_CONSOLE
GOOGLE_CALLBACK_URL=https://live.albiontools.fun/api/auth/google/callback

# === Midtrans (SANDBOX - masih nunggu approval) ===
# Daftar di https://dashboard.midtrans.com/register
# Setelah approved: Settings > Access Keys > copy SB-Mid-... (sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# === SMTP Gmail (2FA harus aktif; JANGAN commit nilai asli) ===
# App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=ISI_APP_PASSWORD_16_KARAKTER
SMTP_FROM=TTS Live Studio <emailkamu@gmail.com>

# === Security ===
ALLOWED_ORIGINS=https://live.albiontools.fun,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3050
# COOKIE_SECRET=acak-panjang-minimal-32-char
DISABLE_RATE_LIMIT=false

# Jumlah hop reverse-proxy di depan app (Cloudflare Tunnel / nginx = 1, tanpa proxy = 0).
# Salah isi -> rate limit per-IP keliru atau IP bisa dipalsukan.
TRUST_PROXY=1

# === Opsional ===
# EULER_API_KEY=            # sign server TikTok Live (lebih stabil, kurangi rate limit)
# OPENAI_API_KEY=           # untuk ai-client.js (generator soal)
# ALLOW_REGISTER=false      # tutup pendaftaran
