<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hitung Cepat Overlay</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: transparent;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .container {
            background: linear-gradient(135deg, #ff6b6b, #c0392b);
            border: 8px solid #f1c40f;
            border-radius: 30px;
            padding: 40px 60px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5), inset 0 5px 15px rgba(255,255,255,0.4);
            text-align: center;
            position: relative;
            transform-style: preserve-3d;
            animation: float 4s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(-2deg); }
            50% { transform: translateY(-15px) rotate(2deg); }
        }

        .title {
            font-size: 2.5rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #f1c40f;
            text-shadow: 3px 3px 0 #c0392b, -1px -1px 0 #fff;
            margin-bottom: 20px;
            margin-top: 0;
        }

        .progress-badge {
            display: inline-block;
            background: #2c3e50;
            color: #f1c40f;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .round-info {
            font-size: 0.9rem;
            color: #ecf0f1;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .soal-box {
            background: #ffffff;
            color: #2c3e50;
            font-size: 5rem;
            font-weight: 900;
            padding: 20px 40px;
            border-radius: 20px;
            box-shadow: inset 0 5px 15px rgba(0,0,0,0.2), 0 10px 20px rgba(0,0,0,0.3);
            min-width: 300px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }

        #soal {
            display: inline-block;
        }

        .winners-section {
            margin-top: 20px;
            min-height: 80px;
        }

        .winners-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #f1c40f;
            margin-bottom: 10px;
            text-shadow: 2px 2px 0 #c0392b;
        }

        .winners-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            align-items: center;
        }

        .winner-avatar {
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popIn {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .winner-avatar img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 3px solid #f1c40f;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
            object-fit: cover;
        }

        .winner-avatar .emoji {
            font-size: 50px;
            line-height: 1;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
        }

        .winner-avatar .name {
            font-size: 0.75rem;
            font-weight: 600;
            color: #ecf0f1;
            margin-top: 4px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
            max-width: 60px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .winner-notification {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            background: linear-gradient(to right, #f1c40f, #e67e22);
            color: #ffffff;
            padding: 30px 50px;
            border-radius: 25px;
            font-size: 3rem;
            font-weight: 900;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6), inset 0 5px 15px rgba(255,255,255,0.5);
            border: 5px solid #fff;
            white-space: nowrap;
            opacity: 0;
            z-index: 10;
            pointer-events: none;
            text-shadow: 2px 2px 0 #d35400, -1px -1px 0 #fff;
        }

        .winner-notification.show {
            animation: popInNotification 3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes popInNotification {
            0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
            15% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
            25% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
            80% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
            100% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
        }

        .stars {
            position: absolute;
            top: -20px;
            left: -20px;
            font-size: 3rem;
            animation: pulse 1s infinite alternate;
        }

        .stars.right {
            left: auto;
            right: -20px;
            animation-delay: 0.5s;
        }

        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.3); }
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="stars">⭐</div>
        <div class="stars right">⭐</div>
        <h1 class="title">HITUNG CEPAT</h1>
        
        <div class="round-info">
            Ronde <span id="round-number">1</span>
        </div>
        
        <div class="progress-badge">
            Soal <span id="question-progress">1/6</span>
        </div>
        
        <div class="soal-box">
            <span id="soal">Siap?</span>
        </div>
        
        <div class="winners-section">
            <div class="winners-title">🏆 Pemenang Ronde Ini</div>
            <div id="winners-grid" class="winners-grid">
                <!-- Winners will be populated here -->
            </div>
        </div>
    </div>

    <div id="winner-banner" class="winner-notification">
        🎉 Hore! <br><span id="winner-name" style="color: #2c3e50;">[Nama]</span> <br>menjawab benar! 🎉
    </div>

    <!-- Script wajib: URUTAN INI PENTING! -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
    </script>
    <script src="/shared/v2-bootstrap.js"></script>
    
    <script>
        const winnerBanner = document.getElementById('winner-banner');
        const winnerNameSpan = document.getElementById('winner-name');
        const winnersGrid = document.getElementById('winners-grid');
        
        function showWinner(name) {
            winnerNameSpan.innerText = name;
            
            // Hapus class show kalau sedang muncul agar animasi tereset
            winnerBanner.classList.remove('show');
            
            // Force reflow
            void winnerBanner.offsetWidth;
            
            // Tambahkan class show untuk memicu animasi popIn
            winnerBanner.classList.add('show');
        }

        function renderWinners(winners, avatarType) {
            winnersGrid.innerHTML = '';
            
            if (!winners || winners.length === 0) {
                winnersGrid.innerHTML = '<div style="color: #ecf0f1; font-size: 0.9rem;">Belum ada pemenang</div>';
                return;
            }
            
            winners.forEach(winner => {
                const avatarDiv = document.createElement('div');
                avatarDiv.className = 'winner-avatar';
                
                let avatarHtml = '';
                if (avatarType === 'tiktok' && winner.profileUrl) {
                    avatarHtml = `<img src="${winner.profileUrl}" onerror="this.outerHTML='<span class=\\'emoji\\'>${winner.emoji}</span>'" alt="${winner.name}">`;
                } else {
                    avatarHtml = `<span class="emoji">${winner.emoji}</span>`;
                }
                
                avatarDiv.innerHTML = `
                    ${avatarHtml}
                    <div class="name">${winner.name}</div>
                `;
                
                winnersGrid.appendChild(avatarDiv);
            });
        }

        // v2-bootstrap.js akan auto join room, kita cukup listen update
        socket.on('update', (state) => {
            console.log('Received update:', state);
            
            // Update question
            if (state.question) {
                document.getElementById('soal').innerText = state.question;
            } else {
                document.getElementById('soal').innerText = "???";
            }
            
            // Update progress
            const questionInRound = state.questionInRound || 1;
            const roundNumber = state.roundNumber || 1;
            document.getElementById('question-progress').innerText = `${questionInRound}/6`;
            document.getElementById('round-number').innerText = roundNumber;
            
            // Render winners
            renderWinners(state.roundWinners, state.avatarType);
            
            // Show winner notification
            if (state.answered && state.winnerName) {
                showWinner(state.winnerName);
            }
        });

        // Listen event game switched untuk auto reload
        socket.on('game:switched', () => {
            console.log('Game switched, reloading...');
            window.location.reload();
        });
    </script>
</body>
</html>
