<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Susun Kalimat Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#14101f">
<style>
:root{--bg-start:#0f0a1f;--bg-end:#1a0f2e;--glass-bg:rgba(255,255,255,0.05);--glass-border:rgba(255,255,255,0.1);--accent-purple:#8b5cf6;--accent-blue:#6366f1;--success:#10b981;--gold:#f59e0b;--text-primary:#f3f4f6;--text-muted:#9ca3af}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Poppins',sans-serif;background:linear-gradient(135deg,var(--bg-start) 0%,var(--bg-end) 100%);color:var(--text-primary);overflow:hidden;height:100vh;position:relative}
body::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% 30%,rgba(139,92,246,0.15) 0%,transparent 50%),radial-gradient(circle at 80% 70%,rgba(99,102,241,0.15) 0%,transparent 50%);animation:bgShift 15s ease-in-out infinite;pointer-events:none}
@keyframes bgShift{0%,100%{opacity:0.8;transform:scale(1)}50%{opacity:1;transform:scale(1.1)}}
#app{position:fixed;inset:0;display:flex;flex-direction:column;padding:2.4vh 3vw;gap:1.8vh;z-index:1}
#headerBar{flex:0 0 auto;display:flex;align-items:center;justify-content:center}
#headerBar .title{font-weight:800;font-size:clamp(1rem,3vw,1.5rem);background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;padding:0.5rem 1.5rem;border-radius:50px;border:1px solid var(--glass-border);letter-spacing:0.5px;animation:fadeInDown 0.8s ease}
@keyframes fadeInDown{from{opacity:0;transform:translateY(-30px)}to{opacity:1;transform:translateY(0)}}
#voteHintInline{flex:0 0 auto;overflow:hidden;white-space:nowrap;font-size:clamp(0.75rem,1.8vw,1rem);font-weight:600;color:var(--text-muted);padding:0.2rem 0;-webkit-mask-image:linear-gradient(90deg,transparent,black 4%,black 96%,transparent);mask-image:linear-gradient(90deg,transparent,black 4%,black 96%,transparent)}
#voteHintInline b{color:var(--gold);font-weight:800}
#voteHintInline .marquee-track{display:inline-block;padding-left:100%;animation:marqueeScroll 22s linear infinite}
@keyframes marqueeScroll{0%{transform:translateX(0)}100%{transform:translateX(-100%)}}
#avatarZone{flex:0 0 auto;height:clamp(60px,12vh,100px);position:relative;background:transparent;overflow:visible}
.mini-avatar{position:absolute;bottom:4px;display:flex;flex-direction:column;align-items:center;pointer-events:none;will-change:left}
.mini-avatar .emoji{display:block;font-size:26px;line-height:1;animation:avatarBob 0.5s ease-in-out infinite alternate}
.mini-avatar.facing-left .emoji{transform:scaleX(-1)}
.mini-avatar .name-tag{font-weight:700;font-size:0.65rem;color:var(--text-primary);background:rgba(0,0,0,0.5);padding:0.1rem 0.5rem;border-radius:50px;margin-bottom:0.15rem;white-space:nowrap;max-width:84px;overflow:hidden;text-overflow:ellipsis;order:-1}
.mini-avatar .comment-bubble{font-weight:600;font-size:0.7rem;color:#0f0a1f;background:var(--text-primary);padding:0.25rem 0.6rem;border-radius:10px;margin-bottom:0.3rem;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis;box-shadow:0 2px 6px rgba(0,0,0,0.3);position:relative;order:-2}
.mini-avatar .comment-bubble::after{content:'';position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);border-width:4px 4px 0 4px;border-style:solid;border-color:var(--text-primary) transparent transparent transparent}
@keyframes avatarBob{from{transform:translateY(0)}to{transform:translateY(-4px)}}
#wordArea{flex:1;display:flex;flex-direction:column;gap:1.2vh;min-height:0}
#wordAreaLabel{flex:0 0 auto;text-align:center;font-weight:700;font-size:clamp(0.8rem,2vw,1rem);color:var(--text-muted);letter-spacing:0.5px;text-transform:uppercase}
#wordAreaLabel b{color:var(--gold);font-weight:800}
#itemList{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;gap:1.2vh;overflow-y:auto;padding:10px 10px 4px}
#itemList>:first-child{margin-top:auto}
#itemList>:last-child{margin-bottom:auto}
.q-card{position:relative;flex:0 0 auto;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-border);border-radius:14px;padding:0.6rem 1rem 0.6rem 1.5rem;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.3rem;min-height:clamp(46px,8.5vh,76px);transition:all 0.3s ease;box-shadow:0 4px 16px rgba(0,0,0,0.2);animation:fadeInUp 0.8s ease calc(var(--idx)*0.1s) both}
@keyframes fadeInUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.q-card .num-badge{position:absolute;top:-8px;left:-8px;font-weight:800;font-size:0.8rem;background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));color:#fff;min-width:22px;height:22px;padding:0 0.4rem;border-radius:50px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,0.4)}
.q-card .tiles{display:flex;flex-wrap:wrap;gap:0.3rem 0.5rem;justify-content:center;align-items:center}
.word-tile{background:rgba(255,255,255,0.1);border:1px solid var(--glass-border);border-radius:8px;padding:0.3rem 0.7rem;font-weight:800;font-size:clamp(0.8rem,min(2.6vw,2vh),1.2rem);color:var(--text-primary);box-shadow:0 3px 8px rgba(0,0,0,0.3);letter-spacing:0.3px}
.q-card.solved{background:rgba(16,185,129,0.15);border-color:rgba(16,185,129,0.3);box-shadow:0 4px 16px rgba(16,185,129,0.3)}
.q-card.solved .tiles{display:none}
.q-card .solved-sentence{display:none;font-weight:800;text-align:center;font-size:clamp(0.95rem,3vw,1.4rem);color:var(--success);line-height:1.25}
.q-card.solved .solved-sentence{display:block;animation:popIn 0.3s ease}
.q-card .solved-by{display:none;font-size:clamp(0.7rem,1.8vw,0.9rem);color:var(--text-muted);font-weight:600}
.q-card.solved .solved-by{display:block}
@keyframes popIn{from{transform:scale(0.6);opacity:0}to{transform:scale(1);opacity:1}}
#toast{position:fixed;top:9vh;left:50%;background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));color:white;padding:0.9rem 1.6rem;border-radius:50px;font-weight:800;font-size:clamp(1rem,2.8vw,1.4rem);white-space:nowrap;box-shadow:0 8px 32px rgba(139,92,246,0.6);opacity:0;pointer-events:none;z-index:50;transform:translate(-50%,-60%) scale(0.5)}
#toast.show{animation:toastPop 0.6s cubic-bezier(0.34,1.56,0.64,1) forwards}
@keyframes toastPop{0%{transform:translate(-50%,-60%) scale(0.4);opacity:0}60%{transform:translate(-50%,5%) scale(1.15);opacity:1}100%{transform:translate(-50%,0%) scale(1);opacity:1}}
#leaderboard{position:absolute;top:8px;right:8px;z-index:10;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-border);border-radius:16px;padding:1rem;min-width:clamp(120px,16vw,180px);max-width:240px;box-shadow:0 8px 32px rgba(0,0,0,0.3);animation:slideInRight 0.8s ease 0.5s both}
@keyframes slideInRight{from{opacity:0;transform:translateX(50px)}to{opacity:1;transform:translateX(0)}}
.label{font-weight:700;font-size:clamp(0.75rem,1.7vw,0.9rem);background:linear-gradient(135deg,var(--gold),#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:0.7rem;display:flex;align-items:center;gap:0.3rem}
#lbList{display:flex;flex-direction:column;gap:0.4rem}
.lb-row{display:flex;align-items:center;gap:0.5rem;padding:0.35rem 0.5rem;background:rgba(255,255,255,0.08);border-radius:8px;transition:all 0.3s}
.lb-row:hover{background:rgba(255,255,255,0.15);transform:translateX(4px)}
.lb-rank{font-weight:800;text-shadow:0 2px 8px rgba(0,0,0,0.9), 0 0 4px rgba(0,0,0,0.8);text-shadow:0 2px 8px rgba(0,0,0,0.9), 0 0 4px rgba(0,0,0,0.8);font-size:clamp(0.7rem,1.6vw,0.85rem);width:clamp(16px,3.2vw,22px);text-align:center;color:var(--text-muted)}
.lb-row:nth-child(1) .lb-rank{background:linear-gradient(135deg,#fbbf24,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lb-row:nth-child(2) .lb-rank{background:linear-gradient(135deg,#e5e7eb,#9ca3af);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lb-row:nth-child(3) .lb-rank{background:linear-gradient(135deg,#d97706,#92400e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lb-name{flex:1;font-weight:600;text-shadow:0 2px 8px rgba(0,0,0,0.9), 0 0 4px rgba(0,0,0,0.8);text-shadow:0 2px 8px rgba(0,0,0,0.9), 0 0 4px rgba(0,0,0,0.8);font-size:clamp(0.65rem,1.5vw,0.8rem);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:20vw}
.lb-score{font-weight:700;text-shadow:0 2px 8px rgba(0,0,0,0.9), 0 0 4px rgba(0,0,0,0.8);font-size;text-shadow:0 2px 8px rgba(0,0,0,0.9), 0 0 4px rgba(0,0,0,0.8):clamp(0.65rem,1.5vw,0.8rem);color:var(--accent-purple)}
.empty-hint{color:var(--text-muted);font-size:clamp(0.8rem,1.8vw,1rem);text-align:center;padding:0.8rem 0}
</style>
</head>
<body>
<div id="app">
  <div id="headerBar"><div class="title">🔀 Susun Kalimat</div></div>

  <div id="voteHintInline"><div class="marquee-track">💬 Ketik kalimat yang benar di komentar &nbsp;•&nbsp; Komen <b>SKIP 10x</b> buat kalimat baru &nbsp;•&nbsp; Ketik <b>GANTI 10x</b> buat ganti game &nbsp;•&nbsp; Ketik <b>NYERAH 10x</b> buat lihat jawabannya</div></div>

  <div id="avatarZone"></div>

  <div id="wordArea">
    <div id="wordAreaLabel">Susun kata-kata jadi kalimat <span id="progress"></span></div>
    <div id="itemList"></div>
  </div>

  <div id="hint">Ketik <b>nomor + kalimatnya</b> (contoh: <b>3 ibu memasak nasi goreng</b>) atau langsung kalimatnya</div>
</div>

<div id="leaderboard">
  <div class="label">🏆 Top Skor</div>
  <div id="lbList"><div class="empty-hint">Belum ada yang jawab</div></div>
</div>

<div id="toast"></div>
<div id="banner"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  </script>
  <script src="/shared/v2-bootstrap.js"></script>
  <script src="/shared/game-switch-watcher.js"></script>
  <script src="/shared/vote-overlay.js"></script>
  <script>

  const itemListEl = document.getElementById('itemList');
  const progressEl = document.getElementById('progress');
  const lbList = document.getElementById('lbList');
  const toastEl = document.getElementById('toast');
  const bannerEl = document.getElementById('banner');

  let cardEls = {}; // number -> element, dibikin sekali biar nggak re-render dari nol tiap update

  function ensureCard(number) {
    if (cardEls[number]) return cardEls[number];
    const el = document.createElement('div');
    el.className = 'q-card';
    el.innerHTML = `
      <div class="num-badge">${number}</div>
      <div class="tiles"></div>
      <div class="solved-sentence"></div>
      <div class="solved-by"></div>
    `;
    itemListEl.appendChild(el);
    cardEls[number] = el;
    return el;
  }

  // Server ngirim { items: [...], totalSoal, solvedSoal } -- 1 ronde isinya
  // beberapa kalimat (dulu frontend ini masih nyangka cuma 1 kalimat per
  // ronde, jadi layarnya kosong).
  function renderState(data) {
    if (!data || !Array.isArray(data.items)) return;

    // Buang kartu yang nomornya nggak ada lagi (ronde baru lebih sedikit soalnya)
    const liveNumbers = new Set(data.items.map(it => String(it.number)));
    Object.keys(cardEls).forEach(n => {
      if (!liveNumbers.has(n)) { cardEls[n].remove(); delete cardEls[n]; }
    });

    data.items.forEach(item => {
      const el = ensureCard(item.number);
      const wasActive = !el.classList.contains('solved');

      if (item.solved) {
        el.classList.add('solved');
        if (wasActive) el.classList.add('just-solved'); // baru kejawab -> flash + mantul sekali
        el.querySelector('.solved-sentence').textContent = item.sentence || '';
        el.querySelector('.solved-by').textContent = item.solvedBy ? `oleh ${item.solvedBy}` : '';
      } else {
        el.classList.remove('solved', 'just-solved');
        const tilesEl = el.querySelector('.tiles');
        const key = (item.shuffled || []).join('|');
        // Cuma re-render kata kalau beneran beda, biar nggak flicker
        if (tilesEl.dataset.words !== key) {
          tilesEl.dataset.words = key;
          tilesEl.innerHTML = '';
          (item.shuffled || []).forEach(word => {
            const tile = document.createElement('div');
            tile.className = 'word-tile';
            tile.textContent = word;
            tilesEl.appendChild(tile);
          });
        }
      }
    });

    // Urutkan ulang sesuai nomor (jaga-jaga kalau urutan elemen beda)
    data.items.forEach(item => itemListEl.appendChild(cardEls[item.number]));

    progressEl.innerHTML = data.totalSoal ? `· terjawab <b>${data.solvedSoal || 0}/${data.totalSoal}</b>` : '';
  }

  // Confetti muncul dari kartu yang barusan kejawab (kalau nomornya ada).
  function spawnConfetti(originEl, count = 16) {
    const wrap = originEl || document.getElementById('app');
    const colors = ['#f5b942', '#f472b6', '#5eead4', '#8b6ef5', '#4ade80'];
    for (let i = 0; i < count; i++) {
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      const angle = Math.random() * Math.PI * 2;
      const dist = 50 + Math.random() * 80;
      piece.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
      piece.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);
      piece.style.setProperty('--rot', `${(Math.random() - 0.5) * 540}deg`);
      piece.style.background = colors[i % colors.length];
      piece.style.animationDelay = `${Math.random() * 0.08}s`;
      wrap.appendChild(piece);
      setTimeout(() => piece.remove(), 1000);
    }
  }

  function showToast(data) {
    toastEl.textContent = `🎉 ${data.player} BENAR! No.${data.number} +${data.points}`;
    toastEl.classList.remove('show');
    void toastEl.offsetWidth; // paksa reflow biar animasi bisa diputar ulang
    toastEl.classList.add('show');
    spawnConfetti(cardEls[data.number]);
    clearTimeout(showToast._hideT);
    showToast._hideT = setTimeout(() => toastEl.classList.remove('show'), 2400);
  }

  function renderLeaderboard(list) {
    if (!list || list.length === 0) {
      lbList.innerHTML = '<div class="empty-hint">Belum ada yang jawab</div>';
      return;
    }
    lbList.innerHTML = list.map((row, i) => `
      <div class="lb-row">
        <span class="lb-rank">${i + 1}</span>
        <span class="lb-name">${escapeHtml(row.player)}</span>
        <span class="lb-score">${row.score}</span>
      </div>`).join('');
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function showBanner(msg) { bannerEl.textContent = msg; bannerEl.classList.add('show'); }
  function hideBanner() { bannerEl.classList.remove('show'); }

  socket.on('game:switched', () => window.location.reload());
  socket.on('update', (data) => renderState(data));
  socket.on('answer:correct', (data) => showToast(data));
  socket.on('leaderboard:update', (list) => renderLeaderboard(list));
  socket.on('puzzle:completed', () => showBanner('🎉 Kalimat terjawab! Menyiapkan kalimat baru...'));
  socket.on('puzzle:new', () => hideBanner());
  socket.on('puzzle:error', (data) => { showBanner('⚠️ ' + data.message); setTimeout(hideBanner, 4000); });

  // ===== Avatar viewer =====
  const avatarZone = document.getElementById('avatarZone');
  const activeAvatars = {};

  function spawnAvatar(player, emoji, profileUrl, avatarType) {
    if (activeAvatars[player]) return;
    const el = document.createElement('div');
    el.className = 'mini-avatar';
    let avatarHtml = `<span class="emoji">${emoji}</span>`;
    if (avatarType === 'tiktok' && profileUrl) {
       avatarHtml = `<img src="${profileUrl}" onerror="this.outerHTML='<span class=\'emoji\'>${emoji}</span>'" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:2px;border:1px solid #fff;display:inline-block;vertical-align:middle;" />`;
    }
    el.innerHTML = `${avatarHtml}<span class="name-tag">${escapeHtml(player)}</span>`;
    avatarZone.appendChild(el);
    el.style.left = (Math.random() * Math.max(0, avatarZone.clientWidth - 40)) + 'px';
    activeAvatars[player] = { el, timer: null };
    walkRandomly(player);
  }

  function walkRandomly(player) {
    const entry = activeAvatars[player];
    if (!entry) return;
    const zoneWidth = avatarZone.clientWidth || 300;
    const avatarWidth = entry.el.offsetWidth || 40;
    const maxLeft = Math.max(0, zoneWidth - avatarWidth);
    const currentLeft = parseFloat(entry.el.style.left) || 0;
    const targetLeft = Math.random() * maxLeft;
    const duration = 2.5 + Math.random() * 3;
    entry.el.classList.toggle('facing-left', targetLeft < currentLeft);
    entry.el.style.transition = `left ${duration}s linear`;
    entry.el.style.left = targetLeft + 'px';
    entry.timer = setTimeout(() => walkRandomly(player), duration * 1000);
  }

  function showComment(player, text) {
    const entry = activeAvatars[player];
    if (!entry) return;
    let bubble = entry.el.querySelector('.comment-bubble');
    if (!bubble) {
      bubble = document.createElement('span');
      bubble.className = 'comment-bubble';
      entry.el.appendChild(bubble);
    }
    bubble.textContent = text;
    clearTimeout(entry.commentTimer);
    entry.commentTimer = setTimeout(() => bubble.remove(), 4000);
  }

  function clearAllAvatars() {
    Object.values(activeAvatars).forEach(({ el, timer, commentTimer }) => {
      clearTimeout(timer); clearTimeout(commentTimer); el.remove();
    });
    for (const key in activeAvatars) delete activeAvatars[key];
  }

  function removeAvatar(player) {
    const entry = activeAvatars[player];
    if (!entry) return;
    clearTimeout(entry.timer); clearTimeout(entry.commentTimer);
    entry.el.remove(); delete activeAvatars[player];
  }

  socket.on('avatar:spawn', (data) => spawnAvatar(data.player, data.emoji, data.profileUrl, data.avatarType));
  socket.on('avatar:sync', (list) => { clearAllAvatars(); list.forEach((d) => spawnAvatar(d.player, d.emoji, d.profileUrl, d.avatarType)); });
  socket.on('avatar:reset', clearAllAvatars);
  socket.on('avatar:remove', ({ player }) => removeAvatar(player));
  socket.on('chat:comment', ({ player, text }) => showComment(player, text));

  // ===== Visual viewport fix (Android WebView) =====
  const appEl = document.getElementById('app');
  function syncVisibleArea() {
    if (window.visualViewport) {
      appEl.style.height = window.visualViewport.height + 'px';
      appEl.style.top = window.visualViewport.offsetTop + 'px';
    } else {
      appEl.style.height = window.innerHeight + 'px';
    }
  }
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', syncVisibleArea);
    window.visualViewport.addEventListener('scroll', syncVisibleArea);
  }
  window.addEventListener('resize', syncVisibleArea);
  syncVisibleArea();

  // ===== Wake lock =====
  let wakeLock = null;
  let noSleepStarted = false;

  function startNoSleepFallback() {
    if (noSleepStarted) return;
    noSleepStarted = true;
    try {
      const canvas = document.createElement('canvas');
      canvas.width = 2; canvas.height = 2;
      canvas.getContext('2d').fillRect(0, 0, 2, 2);
      const stream = canvas.captureStream(1);
      const video = document.createElement('video');
      video.muted = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('autoplay', '');
      video.style.cssText = 'position:fixed;bottom:0;right:0;width:1px;height:1px;opacity:0.01;pointer-events:none;';
      video.srcObject = stream;
      document.body.appendChild(video);
      video.play().catch(() => {});
    } catch (e) {}
  }

  async function requestWakeLock() {
    if ('wakeLock' in navigator) {
      try {
        wakeLock = await navigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => { wakeLock = null; });
        return;
      } catch (e) {}
    }
    startNoSleepFallback();
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && wakeLock === null) requestWakeLock();
  });
  requestWakeLock();

  document.body.addEventListener('click', function goFullscreen() {
    document.documentElement.requestFullscreen().catch(() => {});
    requestWakeLock();
    document.body.removeEventListener('click', goFullscreen);
  }, { once: true });
</script>
</body>
</html>