<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Family 100 Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#14101f">
<style>
  :root {
    --bg-deep: #14101f;
    --panel: #1f1a33;
    --panel-light: #2a2340;
    --accent: #8b6ef5;
    --accent-soft: rgba(139, 110, 245, 0.25);
    --gold: #f5b942;
    --silver: #c9c9d4;
    --bronze: #d08a5b;
    --text-primary: #f5f3fb;
    --text-muted: #9b93b8;
    --slot-bg: #2a2340;
    --slot-found: #1a3a2a;
    --slot-border: #3a3360;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    width: 100vw; height: 100vh;
    background: var(--bg-deep);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  #app {
    display: flex; flex-direction: column;
    width: 100vw; height: 100vh;
    padding: 3vh 3vw 2vh;
    gap: 1.6vh;
  }

  /* Question bar */
  #questionBar {
    flex: 0 0 auto;
    background: var(--gold);
    border-radius: 12px;
    padding: 10px 18px;
    display: flex; align-items: center; justify-content: space-between;
    box-shadow: 0 3px 12px rgba(245, 185, 66, 0.3);
  }
  #questionBar .qbar-label {
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(8px, 2vw, 11px); color: #5c3d00;
    background: rgba(0,0,0,0.12); padding: 3px 8px; border-radius: 999px;
    letter-spacing: 0.3px; white-space: nowrap;
  }
  #questionBar .qbar-text {
    font-family: 'Baloo 2', sans-serif; font-weight: 700;
    font-size: clamp(13px, 3.2vw, 18px); color: #241c3a; flex: 1;
    text-align: center; padding: 0 10px;
  }
  #questionBar .qbar-progress {
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(12px, 2.8vw, 15px); color: #241c3a; white-space: nowrap;
  }

  /* Hint fitur vote ganti/skip, nempel di bawah question bar.
     Dibikin running text (1 baris, scroll ke kiri terus) biar nggak
     makan tempat vertikal kayak sebelumnya (dulu 2 baris pake <br>). */
  #voteHintInline {
    flex: 0 0 auto;
    overflow: hidden;
    white-space: nowrap;
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 3vw, 15px);
    font-weight: 600;
    color: var(--text-muted);
    text-shadow: 0 2px 6px rgba(0,0,0,0.6);
    padding: 3px 0;
    /* Fade tipis di kiri-kanan biar teks yang masuk/keluar nggak keliatan kepotong kasar */
    -webkit-mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  }
  #voteHintInline b { color: var(--gold); font-weight: 800; }
  #voteHintInline .marquee-track {
    display: inline-block;
    padding-left: 100%;
    animation: marqueeScroll 20s linear infinite;
  }
  @keyframes marqueeScroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  /* Board area */
  #boardWrap {
    flex: 2; display: flex; align-items: flex-start; justify-content: center;
    min-height: 0; position: relative; padding-top: 0.5vh;
  }
  #board {
    display: flex; flex-direction: column;
    gap: 6px; width: 100%; max-width: 520px;
  }
  .slot {
    display: flex; align-items: center;
    background: var(--slot-bg);
    border: 2px solid var(--slot-border);
    border-radius: 10px;
    padding: 0;
    min-height: clamp(40px, 7vh, 56px);
    transition: all 0.4s cubic-bezier(.34,1.56,.64,1);
    overflow: hidden;
  }
  .slot.found {
    background: var(--slot-found);
    border-color: #4ade80;
  }
  .slot-rank {
    flex: 0 0 auto;
    width: clamp(32px, 5vw, 44px);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(14px, 3vw, 20px);
    color: var(--text-muted);
    background: rgba(0,0,0,0.15);
    align-self: stretch;
  }
  .slot.found .slot-rank { color: #4ade80; }
  .slot-content {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 6px 12px;
    font-family: 'Baloo 2', sans-serif; font-weight: 700;
    font-size: clamp(14px, 3.4vw, 20px);
    color: var(--text-muted);
    letter-spacing: 1px;
  }
  .slot.found .slot-content {
    color: var(--text-primary);
    letter-spacing: 0;
  }
  .slot-points {
    flex: 0 0 auto;
    width: clamp(40px, 6vw, 56px);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(14px, 3vw, 20px);
    color: transparent;
    background: rgba(0,0,0,0.15);
    align-self: stretch;
  }
  .slot.found .slot-points {
    color: var(--gold);
  }
  .slot-player {
    font-size: clamp(9px, 1.8vw, 11px);
    color: var(--accent);
    font-weight: 600;
    margin-left: 6px;
  }

  /* Slot reveal animation */
  .slot.reveal {
    animation: slotReveal 0.5s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes slotReveal {
    0%   { transform: scaleY(0.3); opacity: 0.3; }
    50%  { transform: scaleY(1.08); }
    100% { transform: scaleY(1); opacity: 1; }
  }

  /* Toast */
  #toast {
    position: absolute; top: -6px; left: 50%;
    background: var(--accent); color: #14101f;
    padding: 12px 22px; border-radius: 999px; font-weight: 800;
    font-family: 'Baloo 2', sans-serif;
    font-size: clamp(14px, 3.6vw, 19px); white-space: nowrap;
    box-shadow: 0 0 0 rgba(0,0,0,0);
    opacity: 0; pointer-events: none; z-index: 6;
    transform: translate(-50%, -60%) scale(0.5);
  }
  #toast.show {
    animation: toastPop 0.55s cubic-bezier(.34,1.56,.64,1) forwards,
               toastGlow 0.55s ease-out forwards;
  }
  @keyframes toastPop {
    0%   { transform: translate(-50%, -60%) scale(0.4) rotate(-4deg); opacity: 0; }
    55%  { transform: translate(-50%, 12%) scale(1.22) rotate(2deg); opacity: 1; }
    75%  { transform: translate(-50%, -6%) scale(0.94) rotate(-1deg); }
    100% { transform: translate(-50%, 0%) scale(1) rotate(0deg); opacity: 1; }
  }
  @keyframes toastGlow {
    0% { box-shadow: 0 0 0 rgba(0,0,0,0); }
    50% { box-shadow: 0 0 32px 6px var(--toast-glow, rgba(139,110,245,0.7)); }
    100% { box-shadow: 0 0 14px 2px var(--toast-glow, rgba(139,110,245,0.4)); }
  }
  .confetti-piece {
    position: absolute; top: 50%; left: 50%;
    width: 7px; height: 7px; border-radius: 2px;
    pointer-events: none; z-index: 7;
    animation: confettiBurst 0.85s cubic-bezier(.25,.8,.35,1) forwards;
  }
  @keyframes confettiBurst {
    0%   { transform: translate(-50%, -50%) translate(0, 0) rotate(0deg) scale(1); opacity: 1; }
    100% { transform: translate(-50%, -50%) translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(0.4); opacity: 0; }
  }

  /* Avatar zone */
  #avatarZone {
    flex: 0 0 80px;
    position: relative;
    background: transparent;
    border-radius: 12px;
    overflow: visible;
    min-height: 80px;
  }
  .mini-avatar {
    position: absolute;
    bottom: 4px;
    display: flex; flex-direction: column; align-items: center;
    pointer-events: none;
    will-change: left;
  }
  .mini-avatar .emoji {
    display: block; font-size: 26px; line-height: 1;
    animation: avatarBob 0.5s ease-in-out infinite alternate;
  }
  .mini-avatar.facing-right .emoji { transform: scaleX(-1); }
  .mini-avatar .name-tag {
    font-family: 'Baloo 2', sans-serif; font-weight: 700; font-size: 8px;
    color: var(--text-primary); background: rgba(0,0,0,0.45);
    padding: 1px 6px; border-radius: 999px; margin-bottom: 2px;
    white-space: nowrap; max-width: 84px; overflow: hidden; text-overflow: ellipsis;
    order: -1;
  }
  .mini-avatar .comment-bubble {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 9.5px;
    color: #14101f; background: var(--text-primary);
    padding: 3px 9px; border-radius: 10px; margin-bottom: 4px;
    white-space: nowrap; max-width: 150px; overflow: hidden; text-overflow: ellipsis;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    position: relative; order: -2;
  }
  .mini-avatar .comment-bubble::after {
    content: '';
    position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%);
    border-width: 4px 4px 0 4px; border-style: solid;
    border-color: var(--text-primary) transparent transparent transparent;
  }
  @keyframes avatarBob {
    from { transform: translateY(0); }
    to   { transform: translateY(-4px); }
  }

  /* Leaderboard */
  #leaderboard {
    position: absolute; top: 8px; right: 8px; z-index: 4;
    background: rgba(31, 26, 51, 0.65); border-radius: 12px;
    padding: 8px 10px; display: flex; flex-direction: column;
    min-width: 120px; max-width: 44vw;
  }
  #leaderboard .label {
    font-family: 'Baloo 2', sans-serif; font-weight: 600;
    font-size: 10px; color: var(--gold);
    margin-bottom: 5px; display: flex; align-items: center; gap: 4px;
  }
  #lbList { display: flex; flex-direction: column; gap: 3px; }
  .lb-row { display: flex; align-items: center; gap: 6px; }
  .lb-rank {
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: 10px; width: 12px; text-align: center; color: var(--text-muted);
  }
  .lb-row:nth-child(1) .lb-rank { color: var(--gold); }
  .lb-row:nth-child(2) .lb-rank { color: var(--silver); }
  .lb-row:nth-child(3) .lb-rank { color: var(--bronze); }
  .lb-name { flex: 1; font-weight: 600; font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 20vw; }
  .lb-score { font-family: 'Baloo 2', sans-serif; font-weight: 700; color: var(--accent); font-size: 10.5px; }
  .empty-hint { color: var(--text-muted); font-size: 13px; text-align: center; padding-top: 10px; }

  #banner {
    position: fixed; bottom: 2vh; left: 50%; transform: translateX(-50%);
    background: var(--panel-light); border: 1px solid var(--accent);
    color: var(--text-primary); padding: 10px 20px; border-radius: 999px;
    font-size: 13px; font-weight: 600; display: none; z-index: 10;
  }
  #banner.show { display: block; }

  /* Slot shuffle animation */
  .slot.shuffle-up {
    animation: shuffleUp 0.4s cubic-bezier(.34,1.56,.64,1);
  }
  .slot.shuffle-down {
    animation: shuffleDown 0.4s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes shuffleUp {
    0%   { transform: translateY(100%); opacity: 0.5; }
    100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes shuffleDown {
    0%   { transform: translateY(-100%); opacity: 0.5; }
    100% { transform: translateY(0); opacity: 1; }
  }

  @media (orientation: landscape) {
    #app {
      display: grid;
      grid-template-columns: 1fr minmax(100px, 22%);
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        "question question"
        "avatars  avatars"
        "board    board";
      gap: 1.4vh 1.6vw;
      padding: 2vh 2.4vw;
    }
    #questionBar { grid-area: question; }
    #boardWrap { grid-area: board; }
    #avatarZone { grid-area: avatars; }
    #board { max-width: 600px; }
  }
</style>
</head>
<body>
  <div id="app">
    <div id="questionBar">
      <span class="qbar-label">FAMILY 100</span>
      <span class="qbar-text">Menunggu soal...</span>
      <span class="qbar-progress">0/7</span>
    </div>
    <div id="voteHintInline"><div class="marquee-track">💬 Komen <b>SKIP 10x</b> rame-rame kalo kesulitan &nbsp;•&nbsp; ketik <b>GANTI 10x</b> buat ganti game &nbsp;•&nbsp; kalo kalian nggak bisa nerima kenyataan dari kekalahan, komen <b>NYERAH 10x</b> 🤣🤣🤣 niscaya aku kasih jawabannya</div></div>

    <div id="avatarZone"></div>

    <div id="boardWrap">
      <div id="toast"></div>
      <div id="board"></div>
    </div>
  </div>

  <div id="leaderboard">
    <div class="label">🏆 Papan Skor</div>
    <div id="lbList"><div class="empty-hint">Belum ada</div></div>
  </div>

  <div id="banner"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
  </script>
  <script src="/shared/v2-bootstrap.js"></script>
  <script src="/shared/game-switch-watcher.js"></script>
  <script>
    const boardEl = document.getElementById('board');
    const qbarText = document.querySelector('.qbar-text');
    const qbarProgress = document.querySelector('.qbar-progress');

    let lastState = null;
    let prevBoard = []; // track previous board state for animation

    function renderBoard(data) {
      const oldBoard = prevBoard;
      lastState = data;
      const { board, boardSlots, question, filledCount } = data;

      qbarText.textContent = question || 'Menunggu soal...';
      qbarProgress.textContent = `${filledCount}/${boardSlots}`;

      boardEl.innerHTML = '';
      prevBoard = board.map(b => b ? b.text : null);

      for (let i = 0; i < boardSlots; i++) {
        const slot = document.createElement('div');
        slot.className = 'slot';

        const rankEl = document.createElement('div');
        rankEl.className = 'slot-rank';
        rankEl.textContent = i + 1;

        const contentEl = document.createElement('div');
        contentEl.className = 'slot-content';

        const pointsEl = document.createElement('div');
        pointsEl.className = 'slot-points';

        if (board[i]) {
          slot.classList.add('found');
          contentEl.innerHTML = `${board[i].text}<span class="slot-player">${board[i].foundBy || ''}</span>`;
          pointsEl.textContent = board[i].points;

          // Check if this is a new entry or moved position
          const wasAtIndex = oldBoard.indexOf(board[i].text);
          if (wasAtIndex === -1) {
            // New entry
            slot.classList.add('reveal');
          } else if (wasAtIndex !== i) {
            // Moved position
            slot.classList.add(wasAtIndex > i ? 'shuffle-up' : 'shuffle-down');
          }
        } else {
          contentEl.textContent = '???';
          pointsEl.textContent = '';
        }

        slot.appendChild(rankEl);
        slot.appendChild(contentEl);
        slot.appendChild(pointsEl);
        boardEl.appendChild(slot);
      }
    }

    function spawnConfetti(count = 18) {
      const wrap = document.getElementById('boardWrap');
      const colors = ['#f5b942', '#f472b6', '#5eead4', '#8b6ef5', '#4ade80'];
      for (let i = 0; i < count; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        const angle = Math.random() * Math.PI * 2;
        const dist = 60 + Math.random() * 90;
        piece.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
        piece.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);
        piece.style.setProperty('--rot', `${(Math.random() - 0.5) * 540}deg`);
        piece.style.background = colors[i % colors.length];
        piece.style.animationDelay = `${Math.random() * 0.08}s`;
        wrap.appendChild(piece);
        setTimeout(() => piece.remove(), 1000);
      }
    }

    function showToast(data) {
      const toast = document.getElementById('toast');
      toast.textContent = `🎉 ${data.player} BENAR! "${data.answer}" +${data.points}`;
      toast.style.background = 'var(--accent)';
      toast.style.setProperty('--toast-glow', 'rgba(139,110,245,0.7)');
      toast.classList.remove('show');
      void toast.offsetWidth;
      toast.classList.add('show');
      spawnConfetti();
      clearTimeout(showToast._hideT);
      showToast._hideT = setTimeout(() => toast.classList.remove('show'), 2400);
    }

    function renderLeaderboard(list) {
      const lb = document.getElementById('lbList');
      if (!list.length) { lb.innerHTML = '<div class="empty-hint">Belum ada</div>'; return; }
      lb.innerHTML = list.map((row, i) => `
        <div class="lb-row">
          <span class="lb-rank">${i + 1}</span>
          <span class="lb-name">${row.player}</span>
          <span class="lb-score">${row.score}</span>
        </div>
      `).join('');
    }

    function showBanner(msg) {
      const banner = document.getElementById('banner');
      banner.textContent = msg;
      banner.classList.add('show');
    }
    function hideBanner() {
      document.getElementById('banner').classList.remove('show');
    }

    // Avatar system (same as cari-kata)
    const avatarZone = document.getElementById('avatarZone');
    const activeAvatars = {};

    function spawnAvatar(player, emoji, profileUrl, avatarType) {
      if (activeAvatars[player]) return;
      const el = document.createElement('div');
      el.className = 'mini-avatar';
      let avatarHtml = `<span class="emoji">${emoji}</span>`;
      if (avatarType === 'tiktok' && profileUrl) {
         avatarHtml = `<img src="${profileUrl}" onerror="this.outerHTML='<span class=\'emoji\'>${emoji}</span>'" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:2px;border:1px solid #fff;display:inline-block;vertical-align:middle;" />`;
      }
      el.innerHTML = `${avatarHtml}<span class="name-tag">${player}</span>`;
      avatarZone.appendChild(el);
      const startLeft = Math.random() * Math.max(0, avatarZone.clientWidth - 40);
      el.style.left = startLeft + 'px';
      activeAvatars[player] = { el, timer: null };
      walkRandomly(player);
    }

    function walkRandomly(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      const zoneWidth = avatarZone.clientWidth || 300;
      const avatarWidth = entry.el.offsetWidth || 40;
      const maxLeft = Math.max(0, zoneWidth - avatarWidth);
      const currentLeft = parseFloat(entry.el.style.left) || 0;
      const targetLeft = Math.random() * maxLeft;
      const duration = 2.5 + Math.random() * 3;
      entry.el.classList.toggle('facing-right', targetLeft > currentLeft);
      entry.el.style.transition = `left ${duration}s linear`;
      entry.el.style.left = targetLeft + 'px';
      entry.timer = setTimeout(() => walkRandomly(player), duration * 1000);
    }

    function showComment(player, text) {
      const entry = activeAvatars[player];
      if (!entry) return;
      let bubble = entry.el.querySelector('.comment-bubble');
      if (!bubble) {
        bubble = document.createElement('span');
        bubble.className = 'comment-bubble';
        entry.el.appendChild(bubble);
      }
      bubble.textContent = text;
      clearTimeout(entry.commentTimer);
      entry.commentTimer = setTimeout(() => bubble.remove(), 4000);
    }

    function clearAllAvatars() {
      Object.values(activeAvatars).forEach(({ el, timer, commentTimer }) => {
        clearTimeout(timer);
        clearTimeout(commentTimer);
        el.remove();
      });
      for (const key in activeAvatars) delete activeAvatars[key];
    }

    function removeAvatar(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      clearTimeout(entry.timer);
      clearTimeout(entry.commentTimer);
      entry.el.remove();
      delete activeAvatars[player];
    }

    socket.on('game:switched', () => window.location.reload());

    socket.on('avatar:spawn', (data) => spawnAvatar(data.player, data.emoji, data.profileUrl, data.avatarType));
    socket.on('avatar:sync', (list) => { clearAllAvatars(); list.forEach((d) => spawnAvatar(d.player, d.emoji, d.profileUrl, d.avatarType)); });
    socket.on('avatar:reset', clearAllAvatars);
    socket.on('avatar:remove', ({ player }) => removeAvatar(player));
    socket.on('chat:comment', ({ player, text }) => showComment(player, text));

    socket.on('update', (data) => renderBoard(data));
    socket.on('answer:correct', (data) => showToast(data));
    socket.on('leaderboard:update', (list) => renderLeaderboard(list));
    socket.on('puzzle:completed', () => showBanner('🎉 Papan penuh! Sedang menyiapkan soal baru...'));
    socket.on('puzzle:new', () => { hideBanner(); prevBoard = []; });
    socket.on('puzzle:error', (data) => { showBanner('⚠️ ' + data.message); setTimeout(hideBanner, 4000); });
  </script>
  <script src="/shared/vote-overlay.js"></script>
  <script>
    // (sengaja kosong -- vote-overlay.js pakai variabel `socket` dari script di atas)

    // Wake lock
    let wakeLock = null;
    let noSleepStarted = false;

    function startNoSleepFallback() {
      if (noSleepStarted) return;
      noSleepStarted = true;
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 2; canvas.height = 2;
        canvas.getContext('2d').fillRect(0, 0, 2, 2);
        const stream = canvas.captureStream(1);
        const video = document.createElement('video');
        video.muted = true;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('autoplay', '');
        video.style.cssText = 'position:fixed;bottom:0;right:0;width:1px;height:1px;opacity:0.01;pointer-events:none;';
        video.srcObject = stream;
        document.body.appendChild(video);
        video.play().catch(() => {});
      } catch (e) {
        console.error('Wake lock fallback gagal:', e.message);
      }
    }

    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLock = await navigator.wakeLock.request('screen');
          wakeLock.addEventListener('release', () => { wakeLock = null; });
          return;
        } catch (e) {
          console.error('Wake Lock API gagal:', e.message);
        }
      }
      startNoSleepFallback();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wakeLock === null) requestWakeLock();
    });

    requestWakeLock();

    document.body.addEventListener('click', function goFullscreen() {
      document.documentElement.requestFullscreen().catch(() => {});
      requestWakeLock();
      document.body.removeEventListener('click', goFullscreen);
    }, { once: true });
  </script>
</body>
</html>
