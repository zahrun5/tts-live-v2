<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Family 100 Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#14101f">
<style>
:root {
  --bg-start: #0f0a1f;
  --bg-end: #1a0f2e;
  --glass-bg: rgba(255, 255, 255, 0.25);
  --glass-border: rgba(255, 255, 255, 0.1);
  --accent-purple: #8b5cf6;
  --accent-blue: #6366f1;
  --success: #10b981;
  --gold: #f59e0b;
  --text-primary: #f3f4f6;
  --text-muted: #9ca3af;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
  color: var(--text-primary);
  overflow: hidden;
  height: 100vh;
  position: relative;
}
body::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(99, 102, 241, 0.15) 0%, transparent 50%);
  animation: bgShift 15s ease-in-out infinite;
  pointer-events: none;
}
@keyframes bgShift {
  0%, 100% { opacity: 0.8; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}
#app {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 2vh 2vw;
  gap: 1.5vh;
  position: relative;
  z-index: 1;
}
#questionBar {
  flex: 0 0 auto;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  animation: fadeInDown 0.8s ease;
}
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-30px); }
  to { opacity: 1; transform: translateY(0); }
}
.qbar-label {
  font-weight: 800;
  font-size: clamp(0.7rem, 1.8vw, 0.95rem);
  background: linear-gradient(135deg, var(--gold), #fbbf24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  padding: 0.3rem 0.8rem;
  border-radius: 50px;
  border: 1px solid rgba(245, 158, 11, 0.3);
  letter-spacing: 1px;
  white-space: nowrap;
}
.qbar-text {
  font-weight: 700;
  font-size: clamp(1rem, 2.8vw, 1.6rem);
  color: var(--text-primary);
  flex: 1;
  text-align: center;
  padding: 0 1rem;
}
.qbar-progress {
  font-weight: 800;
  font-size: clamp(0.9rem, 2.2vw, 1.3rem);
  color: var(--text-muted);
  white-space: nowrap;
}
#voteHintInline {
  flex: 0 0 auto;
  overflow: hidden;
  white-space: nowrap;
  font-size: clamp(0.75rem, 1.8vw, 1rem);
  font-weight: 600;
  color: var(--text-muted);
  padding: 0.2rem 0;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
}
#voteHintInline b { color: var(--gold); font-weight: 800; }
#voteHintInline .marquee-track {
  display: inline-block;
  padding-left: 100%;
  animation: marqueeScroll 20s linear infinite;
}
@keyframes marqueeScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
#avatarZone {
  flex: 0 0 70px;
  position: relative;
  background: transparent;
  overflow: visible;
  min-height: 70px;
}
.mini-avatar {
  position: absolute;
  bottom: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  will-change: left;
}
.mini-avatar .emoji {
  display: block;
  font-size: 28px;
  line-height: 1;
  animation: avatarBob 0.5s ease-in-out infinite alternate;
}
.mini-avatar.facing-right .emoji { transform: scaleX(-1); }
.mini-avatar .name-tag {
  font-weight: 700;
  font-size: 0.7rem;
  color: var(--text-primary);
  background: rgba(0, 0, 0, 0.5);
  padding: 0.15rem 0.5rem;
  border-radius: 50px;
  margin-bottom: 0.2rem;
  white-space: nowrap;
  max-width: 90px;
  overflow: hidden;
  text-overflow: ellipsis;
  order: -1;
}
.mini-avatar .comment-bubble {
  font-weight: 600;
  font-size: 0.75rem;
  color: #0f0a1f;
  background: var(--text-primary);
  padding: 0.3rem 0.7rem;
  border-radius: 10px;
  margin-bottom: 0.3rem;
  white-space: nowrap;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  position: relative;
  order: -2;
}
.mini-avatar .comment-bubble::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%);
  border-width: 4px 4px 0 4px;
  border-style: solid;
  border-color: var(--text-primary) transparent transparent transparent;
}
@keyframes avatarBob {
  from { transform: translateY(0); }
  to { transform: translateY(-4px); }
}
#boardWrap {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 0;
  position: relative;
  padding-top: 0.5vh;
}
#board {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  width: 100%;
  max-width: 600px;
  animation: fadeInUp 0.8s ease 0.3s both;
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
.slot {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  padding: 0;
  min-height: clamp(45px, 8vh, 62px);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}
.slot.found {
  background: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.4);
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
}
.slot-rank {
  flex: 0 0 auto;
  width: clamp(38px, 6vw, 52px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: clamp(1.1rem, 2.8vw, 1.6rem);
  color: var(--text-muted);
  background: rgba(0, 0, 0, 0.2);
  align-self: stretch;
}
.slot.found .slot-rank { color: var(--success); }
.slot-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.6rem 1rem;
  font-weight: 700;
  font-size: clamp(1rem, 2.8vw, 1.5rem);
  color: var(--text-muted);
  letter-spacing: 1px;
}
.slot.found .slot-content {
  color: var(--text-primary);
  letter-spacing: 0;
}
.slot-points {
  flex: 0 0 auto;
  width: clamp(42px, 7vw, 60px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: clamp(1rem, 2.8vw, 1.5rem);
  color: transparent;
  background: rgba(0, 0, 0, 0.2);
  align-self: stretch;
}
.slot.found .slot-points { color: var(--gold); }
.slot-player {
  font-size: clamp(0.7rem, 1.6vw, 0.9rem);
  color: var(--accent-purple);
  font-weight: 600;
  margin-left: 0.5rem;
}
.slot.reveal {
  animation: slotReveal 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes slotReveal {
  0% { transform: scaleY(0.3); opacity: 0.3; }
  50% { transform: scaleY(1.08); }
  100% { transform: scaleY(1); opacity: 1; }
}
#toast {
  position: absolute;
  top: -6px;
  left: 50%;
  background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
  color: white;
  padding: 0.9rem 1.6rem;
  border-radius: 50px;
  font-weight: 800;
  font-size: clamp(1rem, 2.8vw, 1.4rem);
  white-space: nowrap;
  box-shadow: 0 8px 32px rgba(139, 92, 246, 0.6);
  opacity: 0;
  pointer-events: none;
  z-index: 6;
  transform: translate(-50%, -60%) scale(0.5);
}
#toast.show {
  animation: toastPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
@keyframes toastPop {
  0% { transform: translate(-50%, -60%) scale(0.4); opacity: 0; }
  60% { transform: translate(-50%, 5%) scale(1.15); opacity: 1; }
  100% { transform: translate(-50%, 0%) scale(1); opacity: 1; }
}
#leaderboard {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 10;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 1rem;
  min-width: clamp(130px, 18vw, 200px);
  max-width: 260px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  animation: slideInRight 0.8s ease 0.5s both;
}
@keyframes slideInRight {
  from { opacity: 0; transform: translateX(50px); }
  to { opacity: 1; transform: translateX(0); }
}
.label {
  font-weight: 700;
  font-size: clamp(0.75rem, 1.7vw, 0.95rem);
  background: linear-gradient(135deg, var(--gold), #fbbf24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.7rem;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
#lbList {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.lb-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.6rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8px;
  transition: all 0.3s;
}
.lb-row:hover {
  background: rgba(255, 255, 255, 0.08);
  transform: translateX(4px);
}
.lb-rank {
  font-weight: 800;
  font-size: clamp(0.75rem, 1.7vw, 0.95rem);
  width: clamp(18px, 3.5vw, 24px);
  text-align: center;
  color: var(--text-muted);
}
.lb-row:nth-child(1) .lb-rank {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.lb-row:nth-child(2) .lb-rank {
  background: linear-gradient(135deg, #e5e7eb, #9ca3af);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.lb-row:nth-child(3) .lb-rank {
  background: linear-gradient(135deg, #d97706, #92400e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.lb-name {
  flex: 1;
  font-weight: 600;
  font-size: clamp(0.7rem, 1.5vw, 0.85rem);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 20vw;
}
.lb-score {
  font-weight: 700;
  font-size: clamp(0.7rem, 1.5vw, 0.85rem);
  color: var(--accent-purple);
}
.empty-hint {
  color: var(--text-muted);
  font-size: clamp(0.8rem, 1.8vw, 1rem);
  text-align: center;
  padding: 0.8rem 0;
}
#banner {
  position: fixed;
  bottom: 2vh;
  left: 50%;
  transform: translateX(-50%);
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
  padding: 0.8rem 1.5rem;
  border-radius: 50px;
  font-size: clamp(0.85rem, 2vw, 1.1rem);
  font-weight: 600;
  display: none;
  z-index: 10;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}
#banner.show { display: block; }
@media (orientation: landscape) {
  #app {
    display: grid;
    grid-template-columns: 1fr minmax(100px, 22%);
    grid-template-rows: auto 1fr auto;
    grid-template-areas: "question question" "avatars avatars" "board board";
    gap: 1.4vh 1.6vw;
    padding: 2vh 2.4vw;
  }
  #questionBar { grid-area: question; }
  #boardWrap { grid-area: board; }
  #avatarZone { grid-area: avatars; }
  #board { max-width: 650px; }
}
</style>
</head>
<body>
  <div id="app">
    <div id="questionBar">
      <span class="qbar-label">FAMILY 100</span>
      <span class="qbar-text">Menunggu soal...</span>
      <span class="qbar-progress">0/7</span>
    </div>
    <div id="voteHintInline"><div class="marquee-track">💬 Komen <b>SKIP 10x</b> rame-rame kalo kesulitan &nbsp;•&nbsp; ketik <b>GANTI 10x</b> buat ganti game &nbsp;•&nbsp; kalo kalian nggak bisa nerima kenyataan dari kekalahan, komen <b>NYERAH 10x</b> 🤣🤣🤣 niscaya aku kasih jawabannya</div></div>

    <div id="avatarZone"></div>

    <div id="boardWrap">
      <div id="toast"></div>
      <div id="board"></div>
    </div>
  </div>

  <div id="leaderboard">
    <div class="label">🏆 Papan Skor</div>
    <div id="lbList"><div class="empty-hint">Belum ada</div></div>
  </div>

  <div id="banner"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
  </script>
  <script src="/shared/v2-bootstrap.js"></script>
  <script src="/shared/game-switch-watcher.js"></script>
  <script>
    const boardEl = document.getElementById('board');
    const qbarText = document.querySelector('.qbar-text');
    const qbarProgress = document.querySelector('.qbar-progress');

    let lastState = null;
    let prevBoard = []; // track previous board state for animation

    function renderBoard(data) {
      const oldBoard = prevBoard;
      lastState = data;
      const { board, boardSlots, question, filledCount } = data;

      qbarText.textContent = question || 'Menunggu soal...';
      qbarProgress.textContent = `${filledCount}/${boardSlots}`;

      boardEl.innerHTML = '';
      prevBoard = board.map(b => b ? b.text : null);

      for (let i = 0; i < boardSlots; i++) {
        const slot = document.createElement('div');
        slot.className = 'slot';

        const rankEl = document.createElement('div');
        rankEl.className = 'slot-rank';
        rankEl.textContent = i + 1;

        const contentEl = document.createElement('div');
        contentEl.className = 'slot-content';

        const pointsEl = document.createElement('div');
        pointsEl.className = 'slot-points';

        if (board[i]) {
          slot.classList.add('found');
          contentEl.innerHTML = `${board[i].text}<span class="slot-player">${board[i].foundBy || ''}</span>`;
          pointsEl.textContent = board[i].points;

          // Check if this is a new entry or moved position
          const wasAtIndex = oldBoard.indexOf(board[i].text);
          if (wasAtIndex === -1) {
            // New entry
            slot.classList.add('reveal');
          } else if (wasAtIndex !== i) {
            // Moved position
            slot.classList.add(wasAtIndex > i ? 'shuffle-up' : 'shuffle-down');
          }
        } else {
          contentEl.textContent = '???';
          pointsEl.textContent = '';
        }

        slot.appendChild(rankEl);
        slot.appendChild(contentEl);
        slot.appendChild(pointsEl);
        boardEl.appendChild(slot);
      }
    }

    function spawnConfetti(count = 18) {
      const wrap = document.getElementById('boardWrap');
      const colors = ['#f5b942', '#f472b6', '#5eead4', '#8b6ef5', '#4ade80'];
      for (let i = 0; i < count; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        const angle = Math.random() * Math.PI * 2;
        const dist = 60 + Math.random() * 90;
        piece.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
        piece.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);
        piece.style.setProperty('--rot', `${(Math.random() - 0.5) * 540}deg`);
        piece.style.background = colors[i % colors.length];
        piece.style.animationDelay = `${Math.random() * 0.08}s`;
        wrap.appendChild(piece);
        setTimeout(() => piece.remove(), 1000);
      }
    }

    function showToast(data) {
      const toast = document.getElementById('toast');
      toast.textContent = `🎉 ${data.player} BENAR! "${data.answer}" +${data.points}`;
      toast.style.background = 'var(--accent)';
      toast.style.setProperty('--toast-glow', 'rgba(139,110,245,0.7)');
      toast.classList.remove('show');
      void toast.offsetWidth;
      toast.classList.add('show');
      spawnConfetti();
      clearTimeout(showToast._hideT);
      showToast._hideT = setTimeout(() => toast.classList.remove('show'), 2400);
    }

    function renderLeaderboard(list) {
      const lb = document.getElementById('lbList');
      if (!list.length) { lb.innerHTML = '<div class="empty-hint">Belum ada</div>'; return; }
      lb.innerHTML = list.map((row, i) => `
        <div class="lb-row">
          <span class="lb-rank">${i + 1}</span>
          <span class="lb-name">${row.player}</span>
          <span class="lb-score">${row.score}</span>
        </div>
      `).join('');
    }

    function showBanner(msg) {
      const banner = document.getElementById('banner');
      banner.textContent = msg;
      banner.classList.add('show');
    }
    function hideBanner() {
      document.getElementById('banner').classList.remove('show');
    }

    // Avatar system (same as cari-kata)
    const avatarZone = document.getElementById('avatarZone');
    const activeAvatars = {};

    function spawnAvatar(player, emoji, profileUrl, avatarType) {
      if (activeAvatars[player]) return;
      const el = document.createElement('div');
      el.className = 'mini-avatar';
      let avatarHtml = `<span class="emoji">${emoji}</span>`;
      if (avatarType === 'tiktok' && profileUrl) {
         avatarHtml = `<img src="${profileUrl}" onerror="this.outerHTML='<span class=\'emoji\'>${emoji}</span>'" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:2px;border:1px solid #fff;display:inline-block;vertical-align:middle;" />`;
      }
      el.innerHTML = `${avatarHtml}<span class="name-tag">${player}</span>`;
      avatarZone.appendChild(el);
      const startLeft = Math.random() * Math.max(0, avatarZone.clientWidth - 40);
      el.style.left = startLeft + 'px';
      activeAvatars[player] = { el, timer: null };
      walkRandomly(player);
    }

    function walkRandomly(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      const zoneWidth = avatarZone.clientWidth || 300;
      const avatarWidth = entry.el.offsetWidth || 40;
      const maxLeft = Math.max(0, zoneWidth - avatarWidth);
      const currentLeft = parseFloat(entry.el.style.left) || 0;
      const targetLeft = Math.random() * maxLeft;
      const duration = 2.5 + Math.random() * 3;
      entry.el.classList.toggle('facing-right', targetLeft > currentLeft);
      entry.el.style.transition = `left ${duration}s linear`;
      entry.el.style.left = targetLeft + 'px';
      entry.timer = setTimeout(() => walkRandomly(player), duration * 1000);
    }

    function showComment(player, text) {
      const entry = activeAvatars[player];
      if (!entry) return;
      let bubble = entry.el.querySelector('.comment-bubble');
      if (!bubble) {
        bubble = document.createElement('span');
        bubble.className = 'comment-bubble';
        entry.el.appendChild(bubble);
      }
      bubble.textContent = text;
      clearTimeout(entry.commentTimer);
      entry.commentTimer = setTimeout(() => bubble.remove(), 4000);
    }

    function clearAllAvatars() {
      Object.values(activeAvatars).forEach(({ el, timer, commentTimer }) => {
        clearTimeout(timer);
        clearTimeout(commentTimer);
        el.remove();
      });
      for (const key in activeAvatars) delete activeAvatars[key];
    }

    function removeAvatar(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      clearTimeout(entry.timer);
      clearTimeout(entry.commentTimer);
      entry.el.remove();
      delete activeAvatars[player];
    }

    socket.on('game:switched', () => window.location.reload());

    socket.on('avatar:spawn', (data) => spawnAvatar(data.player, data.emoji, data.profileUrl, data.avatarType));
    socket.on('avatar:sync', (list) => { clearAllAvatars(); list.forEach((d) => spawnAvatar(d.player, d.emoji, d.profileUrl, d.avatarType)); });
    socket.on('avatar:reset', clearAllAvatars);
    socket.on('avatar:remove', ({ player }) => removeAvatar(player));
    socket.on('chat:comment', ({ player, text }) => showComment(player, text));

    socket.on('update', (data) => renderBoard(data));
    socket.on('answer:correct', (data) => showToast(data));
    socket.on('leaderboard:update', (list) => renderLeaderboard(list));
    socket.on('puzzle:completed', () => showBanner('🎉 Papan penuh! Sedang menyiapkan soal baru...'));
    socket.on('puzzle:new', () => { hideBanner(); prevBoard = []; });
    socket.on('puzzle:error', (data) => { showBanner('⚠️ ' + data.message); setTimeout(hideBanner, 4000); });
  </script>
  <script src="/shared/vote-overlay.js"></script>
  <script>
    // (sengaja kosong -- vote-overlay.js pakai variabel `socket` dari script di atas)

    // Wake lock
    let wakeLock = null;
    let noSleepStarted = false;

    function startNoSleepFallback() {
      if (noSleepStarted) return;
      noSleepStarted = true;
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 2; canvas.height = 2;
        canvas.getContext('2d').fillRect(0, 0, 2, 2);
        const stream = canvas.captureStream(1);
        const video = document.createElement('video');
        video.muted = true;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('autoplay', '');
        video.style.cssText = 'position:fixed;bottom:0;right:0;width:1px;height:1px;opacity:0.01;pointer-events:none;';
        video.srcObject = stream;
        document.body.appendChild(video);
        video.play().catch(() => {});
      } catch (e) {
        console.error('Wake lock fallback gagal:', e.message);
      }
    }

    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLock = await navigator.wakeLock.request('screen');
          wakeLock.addEventListener('release', () => { wakeLock = null; });
          return;
        } catch (e) {
          console.error('Wake Lock API gagal:', e.message);
        }
      }
      startNoSleepFallback();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wakeLock === null) requestWakeLock();
    });

    requestWakeLock();

    document.body.addEventListener('click', function goFullscreen() {
      document.documentElement.requestFullscreen().catch(() => {});
      requestWakeLock();
      document.body.removeEventListener('click', goFullscreen);
    }, { once: true });
  </script>
</body>
</html>
