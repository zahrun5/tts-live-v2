<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sambung Kata Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1a1d2e">
<style>
:root {
  --bg-start: #0f0a1f;
  --bg-end: #1a0f2e;
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-border: rgba(255, 255, 255, 0.1);
  --accent-purple: #8b5cf6;
  --accent-blue: #6366f1;
  --success: #10b981;
  --gold: #f59e0b;
  --text-primary: #f3f4f6;
  --text-muted: #9ca3af;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
  color: var(--text-primary);
  overflow: hidden;
  height: 100vh;
  position: relative;
}
body::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(99, 102, 241, 0.15) 0%, transparent 50%);
  animation: bgShift 15s ease-in-out infinite;
  pointer-events: none;
}
@keyframes bgShift {
  0%, 100% { opacity: 0.8; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}
#app {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 2vh 2vw;
  gap: 1.5vh;
  position: relative;
  z-index: 1;
}
#letterPanel {
  flex: 0 0 auto;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 1.2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  animation: fadeInDown 0.8s ease;
}
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-30px); }
  to { opacity: 1; transform: translateY(0); }
}
.letterPanel-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.letterPanel-label {
  font-weight: 800;
  font-size: clamp(0.7rem, 1.8vw, 0.9rem);
  background: linear-gradient(135deg, var(--gold), #fbbf24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  padding: 0.3rem 0.8rem;
  border-radius: 50px;
  border: 1px solid rgba(245, 158, 11, 0.3);
  letter-spacing: 1px;
}
.letterPanel-progress {
  font-weight: 700;
  font-size: clamp(0.9rem, 2.2vw, 1.2rem);
  color: var(--text-muted);
}
.letterPanel-progress .num-solved {
  color: var(--success);
}
#letterWheel {
  position: relative;
  width: min(28vh, 35vw);
  height: min(28vh, 35vw);
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(139, 92, 246, 0.1) 0%, rgba(99, 102, 241, 0.05) 70%, transparent 100%);
  border: 3px solid rgba(139, 92, 246, 0.3);
  box-shadow: 
    0 0 40px rgba(139, 92, 246, 0.4),
    inset 0 0 30px rgba(139, 92, 246, 0.1);
  animation: wheelPulse 3s ease-in-out infinite;
}
@keyframes wheelPulse {
  0%, 100% { box-shadow: 0 0 40px rgba(139, 92, 246, 0.4), inset 0 0 30px rgba(139, 92, 246, 0.1); }
  50% { box-shadow: 0 0 60px rgba(139, 92, 246, 0.6), inset 0 0 40px rgba(139, 92, 246, 0.2); }
}
#letterWheel .hub {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20%;
  height: 20%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
  box-shadow: 0 4px 16px rgba(139, 92, 246, 0.5);
}
.letter-bubble {
  position: absolute;
  top: 0;
  left: 0;
  width: 26%;
  height: 26%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--text-primary);
  border: 2px solid var(--glass-border);
  border-radius: 50%;
  font-weight: 900;
  font-size: clamp(1.2rem, 4vw, 2rem);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  animation: letterFloat 3s ease-in-out infinite;
}
@keyframes letterFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
#letterPanel.done {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
}
#avatarZone {
  flex: 0 0 70px;
  position: relative;
  background: transparent;
  overflow: visible;
  min-height: 70px;
}
.mini-avatar {
  position: absolute;
  bottom: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  will-change: left;
}
.mini-avatar .emoji {
  display: block;
  font-size: 28px;
  line-height: 1;
  animation: avatarBob 0.5s ease-in-out infinite alternate;
}
.mini-avatar.facing-right .emoji {
  transform: scaleX(-1);
}
.mini-avatar .name-tag {
  font-weight: 700;
  font-size: 0.7rem;
  color: var(--text-primary);
  background: rgba(0, 0, 0, 0.5);
  padding: 0.15rem 0.5rem;
  border-radius: 50px;
  margin-bottom: 0.2rem;
  white-space: nowrap;
  max-width: 90px;
  overflow: hidden;
  text-overflow: ellipsis;
  order: -1;
}
.mini-avatar .comment-bubble {
  font-weight: 600;
  font-size: 0.75rem;
  color: #0f0a1f;
  background: var(--text-primary);
  padding: 0.3rem 0.7rem;
  border-radius: 10px;
  margin-bottom: 0.3rem;
  white-space: nowrap;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  position: relative;
  order: -2;
}
.mini-avatar .comment-bubble::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%);
  border-width: 4px 4px 0 4px;
  border-style: solid;
  border-color: var(--text-primary) transparent transparent transparent;
}
@keyframes avatarBob {
  from { transform: translateY(0); }
  to { transform: translateY(-4px); }
}
#voteHintInline {
  flex: 0 0 auto;
  overflow: hidden;
  white-space: nowrap;
  font-size: clamp(0.75rem, 1.8vw, 1rem);
  font-weight: 600;
  color: var(--text-muted);
  padding: 0.2rem 0;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
}
#voteHintInline b {
  color: var(--gold);
  font-weight: 800;
}
#voteHintInline .marquee-track {
  display: inline-block;
  padding-left: 100%;
  animation: marqueeScroll 20s linear infinite;
}
@keyframes marqueeScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
#answerWrap {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 0;
  position: relative;
  padding-top: 0.5vh;
}
#answerList {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  width: 100%;
  max-width: 700px;
  animation: fadeInUp 0.8s ease 0.3s both;
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
.answer-slot {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  padding: 0;
  min-height: clamp(45px, 8vh, 60px);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}
.answer-slot.found {
  background: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.4);
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
}
.slot-number {
  flex: 0 0 auto;
  width: clamp(35px, 6vw, 50px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: clamp(1rem, 2.5vw, 1.5rem);
  color: var(--text-muted);
  background: rgba(0, 0, 0, 0.2);
  align-self: stretch;
}
.answer-slot.found .slot-number {
  color: var(--success);
}
.slot-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.6rem 1rem;
  font-weight: 700;
  font-size: clamp(1rem, 2.8vw, 1.4rem);
  color: var(--text-muted);
  letter-spacing: 1px;
}
.answer-slot.found .slot-content {
  color: var(--text-primary);
  letter-spacing: 0.5px;
}
.slot-player {
  font-size: clamp(0.7rem, 1.6vw, 0.9rem);
  color: var(--accent-purple);
  font-weight: 600;
  margin-left: 0.5rem;
}
.answer-slot.reveal {
  animation: slotReveal 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes slotReveal {
  0% { transform: scaleY(0.3); opacity: 0.3; }
  50% { transform: scaleY(1.08); }
  100% { transform: scaleY(1); opacity: 1; }
}
#toast {
  position: absolute;
  top: -6px;
  left: 50%;
  transform: translate(-50%, -130%);
  background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
  color: white;
  padding: 0.8rem 1.5rem;
  border-radius: 50px;
  font-weight: 700;
  font-size: clamp(0.9rem, 2.5vw, 1.2rem);
  white-space: nowrap;
  box-shadow: 0 8px 32px rgba(139, 92, 246, 0.5);
  opacity: 0;
  transition: transform 0.35s ease, opacity 0.35s ease;
  pointer-events: none;
  z-index: 5;
}
#toast.show {
  transform: translate(-50%, 0%);
  opacity: 1;
}
#leaderboard {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 10;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  min-width: clamp(130px, 18vw, 200px);
  max-width: 260px;
  max-height: 85vh;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  animation: slideInRight 0.8s ease 0.5s both;
}
@keyframes slideInRight {
  from { opacity: 0; transform: translateX(50px); }
  to { opacity: 1; transform: translateX(0); }
}
#leaderboard .label {
  font-weight: 700;
  font-size: clamp(0.75rem, 1.7vw, 0.95rem);
  background: linear-gradient(135deg, var(--gold), #fbbf24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.7rem;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
#lbList {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  overflow-y: auto;
  max-height: 75vh;
}
#lbList::-webkit-scrollbar { width: 4px; }
#lbList::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 2px; }
#lbList::-webkit-scrollbar-thumb { background: var(--accent-purple); border-radius: 2px; }
.lb-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.6rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8px;
  transition: all 0.3s;
}
.lb-row:hover {
  background: rgba(255, 255, 255, 0.08);
  transform: translateX(4px);
}
.lb-rank {
  font-weight: 800;
  font-size: clamp(0.75rem, 1.7vw, 0.95rem);
  width: clamp(18px, 3.5vw, 24px);
  text-align: center;
  color: var(--text-muted);
}
.lb-row:nth-child(1) .lb-rank {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.lb-row:nth-child(2) .lb-rank {
  background: linear-gradient(135deg, #e5e7eb, #9ca3af);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.lb-row:nth-child(3) .lb-rank {
  background: linear-gradient(135deg, #d97706, #92400e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.lb-name {
  flex: 1;
  font-weight: 600;
  font-size: clamp(0.7rem, 1.5vw, 0.85rem);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 20vw;
}
.lb-score {
  font-weight: 700;
  font-size: clamp(0.7rem, 1.5vw, 0.85rem);
  color: var(--accent-purple);
}
.empty-hint {
  color: var(--text-muted);
  font-size: clamp(0.8rem, 1.8vw, 1rem);
  text-align: center;
  padding: 0.8rem 0;
}
#banner {
  position: fixed;
  bottom: 2vh;
  left: 50%;
  transform: translateX(-50%);
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
  padding: 0.8rem 1.5rem;
  border-radius: 50px;
  font-size: clamp(0.85rem, 2vw, 1.1rem);
  font-weight: 600;
  display: none;
  z-index: 10;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}
#banner.show {
  display: block;
}
@media (max-width: 480px) {
  #answerList {
    grid-template-columns: 1fr;
    gap: 0.6rem;
    max-width: 400px;
  }
}
@media (orientation: landscape) {
  #app {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 32%);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "letters letters" "avatars avatars" "answers answers";
    gap: 1.4vh 1.6vw;
    padding: 2vh 2.4vw;
  }
  #letterPanel {
    grid-area: letters;
    flex-direction: row;
    justify-content: space-between;
  }
  #letterWheel {
    width: min(18vh, 16vw);
    height: min(18vh, 16vw);
    margin: 0;
  }
  #avatarZone {
    grid-area: avatars;
  }
  #answerWrap {
    grid-area: answers;
    min-width: 0;
  }
}
</style>
</head>
<body>
  <div id="app">
    <div id="letterPanel">
      <div class="letterPanel-top">
        <span class="letterPanel-label">HURUF DASAR</span>
        <span class="letterPanel-progress" id="progressText">Menunggu soal...</span>
      </div>
      <div id="letterWheel"><div class="hub"></div></div>
      <div id="voteHintInline"><div class="marquee-track">💬 Komen <b>SKIP 10x</b> rame-rame kalo kesulitan &nbsp;•&nbsp; ketik <b>GANTI 10x</b> buat ganti game &nbsp;•&nbsp; kalo kalian nggak bisa nerima kenyataan dari kekalahan, komen <b>NYERAH 10x</b> 🤣🤣🤣 niscaya aku kasih jawabannya</div></div>
    </div>

    <div id="avatarZone"></div>

    <div id="answerWrap">
      <div id="toast"></div>
      <div id="answerList"></div>
      <div id="leaderboard">
        <div class="label">🏆 Papan Juara</div>
        <div id="lbList"><div class="empty-hint">Belum ada yang jawab</div></div>
      </div>
    </div>
  </div>

  <div id="banner"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
  </script>
  <script src="/shared/v2-bootstrap.js"></script>
  <script src="/shared/game-switch-watcher.js"></script>
  <script>
    const answerListEl = document.getElementById('answerList');
    const answerWrap = document.getElementById('answerWrap');
    const toastEl = document.getElementById('toast');
    const letterPanelEl = document.getElementById('letterPanel');
    const letterWheelEl = document.getElementById('letterWheel');
    const progressTextEl = document.getElementById('progressText');
    const lbList = document.getElementById('lbList');
    const bannerEl = document.getElementById('banner');

    let currentPuzzle = null;
    let currentBaseLetters = null;
    let toastTimer = null;
    let prevAnswerStates = new Map();

    function renderAnswerList(data) {
      currentPuzzle = data;
      const { words } = data;

      answerListEl.innerHTML = '';

      words.forEach((w, idx) => {
        const slot = document.createElement('div');
        slot.className = 'answer-slot';
        const wordKey = `${w.number}-${w.direction}`;
        
        if (w.answer) {
          slot.classList.add('found');
          
          // Check if this is newly found
          if (!prevAnswerStates.has(wordKey)) {
            slot.classList.add('reveal');
          }
          prevAnswerStates.set(wordKey, true);
        }

        const numberEl = document.createElement('div');
        numberEl.className = 'slot-number';
        numberEl.textContent = w.number;

        const contentEl = document.createElement('div');
        contentEl.className = 'slot-content';
        
        if (w.answer) {
          contentEl.textContent = w.answer;
        } else {
          contentEl.textContent = '?'.repeat(w.length);
        }

        slot.appendChild(numberEl);
        slot.appendChild(contentEl);
        answerListEl.appendChild(slot);
      });
    }

    function renderLetterWheel(baseLetters) {
      if (currentBaseLetters === baseLetters) return;
      currentBaseLetters = baseLetters;

      letterWheelEl.innerHTML = '<div class="hub"></div>';
      if (!baseLetters) return;

      const letters = baseLetters.split('');
      const n = letters.length;
      const radius = 50 - 27 / 2;

      letters.forEach((ch, i) => {
        const angle = (2 * Math.PI * i / n) - Math.PI / 2;
        const cx = 50 + radius * Math.cos(angle);
        const cy = 50 + radius * Math.sin(angle);

        const bubble = document.createElement('div');
        bubble.className = 'letter-bubble';
        bubble.textContent = ch;
        bubble.style.left = `${cx}%`;
        bubble.style.top = `${cy}%`;
        bubble.style.transform = 'translate(-50%, -50%)';
        letterWheelEl.appendChild(bubble);
      });
    }

    function renderProgress(words) {
      const total = words.length;
      const solved = words.filter(w => w.answer).length;

      if (solved === total && total > 0) {
        letterPanelEl.classList.add('done');
        progressTextEl.innerHTML = '🎉 Semua kata ketemu!';
      } else {
        letterPanelEl.classList.remove('done');
        progressTextEl.innerHTML = `<span class="num-solved">${solved}</span> / ${total} kata`;
      }
    }

    function renderLeaderboard(list) {
      if (!list || list.length === 0) {
        lbList.innerHTML = '<div class="empty-hint">Belum ada yang jawab</div>';
        return;
      }
      lbList.innerHTML = list.slice(0, 10).map((row, i) => `
        <div class="lb-row">
          <span class="lb-rank">${i + 1}</span>
          <span class="lb-name">${escapeHtml(row.player)}</span>
          <span class="lb-score">${row.score}</span>
        </div>`).join('');
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function showToast(data) {
      toastEl.textContent = `${data.player} benar! ${data.answer ? data.answer.toUpperCase() : ''}`;
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3000);
    }

    function showBanner(text) { bannerEl.textContent = text; bannerEl.classList.add('show'); }
    function hideBanner() { bannerEl.classList.remove('show'); }

    const avatarZone = document.getElementById('avatarZone');
    const activeAvatars = {};

    function spawnAvatar(player, emoji, profileUrl, avatarType) {
      if (activeAvatars[player]) return;
      const el = document.createElement('div');
      el.className = 'mini-avatar';
      let avatarHtml = `<span class="emoji">${emoji}</span>`;
      if (avatarType === 'tiktok' && profileUrl) {
         avatarHtml = `<img src="${profileUrl}" onerror="this.outerHTML='<span class=\\'emoji\\'>${emoji}</span>'" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:2px;border:1px solid #fff;display:inline-block;vertical-align:middle;" />`;
      }
      el.innerHTML = `${avatarHtml}<span class="name-tag">${player}</span>`;
      avatarZone.appendChild(el);
      const startLeft = Math.random() * Math.max(0, avatarZone.clientWidth - 40);
      el.style.left = startLeft + 'px';
      activeAvatars[player] = { el, timer: null };
      walkRandomly(player);
    }

    function walkRandomly(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      const zoneWidth = avatarZone.clientWidth || 300;
      const avatarWidth = entry.el.offsetWidth || 40;
      const maxLeft = Math.max(0, zoneWidth - avatarWidth);
      const currentLeft = parseFloat(entry.el.style.left) || 0;
      const targetLeft = Math.random() * maxLeft;
      const duration = 2.5 + Math.random() * 3;
      entry.el.classList.toggle('facing-right', targetLeft > currentLeft);
      entry.el.style.transition = `left ${duration}s linear`;
      entry.el.style.left = targetLeft + 'px';
      entry.timer = setTimeout(() => walkRandomly(player), duration * 1000);
    }

    function showComment(player, text) {
      const entry = activeAvatars[player];
      if (!entry) return;
      let bubble = entry.el.querySelector('.comment-bubble');
      if (!bubble) {
        bubble = document.createElement('span');
        bubble.className = 'comment-bubble';
        entry.el.appendChild(bubble);
      }
      bubble.textContent = text;
      clearTimeout(entry.commentTimer);
      entry.commentTimer = setTimeout(() => bubble.remove(), 4000);
    }

    function clearAllAvatars() {
      Object.values(activeAvatars).forEach(({ el, timer, commentTimer }) => {
        clearTimeout(timer);
        clearTimeout(commentTimer);
        el.remove();
      });
      for (const key in activeAvatars) delete activeAvatars[key];
    }

    function removeAvatar(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      clearTimeout(entry.timer);
      clearTimeout(entry.commentTimer);
      entry.el.remove();
      delete activeAvatars[player];
    }

    socket.on('avatar:spawn', (data) => spawnAvatar(data.player, data.emoji, data.profileUrl, data.avatarType));
    socket.on('avatar:sync', (list) => { clearAllAvatars(); list.forEach((d) => spawnAvatar(d.player, d.emoji, d.profileUrl, d.avatarType)); });
    socket.on('avatar:reset', clearAllAvatars);
    socket.on('avatar:remove', ({ player }) => removeAvatar(player));
    socket.on('chat:comment', ({ player, text }) => showComment(player, text));

    socket.on('game:switched', () => window.location.reload());
    socket.on('update', (data) => {
      renderAnswerList(data);
      renderLetterWheel(data.baseLetters);
      renderProgress(data.words);
    });
    socket.on('answer:correct', (data) => showToast(data));
    socket.on('leaderboard:update', (list) => renderLeaderboard(list));
    socket.on('puzzle:completed', () => showBanner('🎉 Semua kata ketemu! Menyiapkan soal baru...'));
    socket.on('puzzle:new', () => { currentBaseLetters = null; prevAnswerStates.clear(); hideBanner(); });
    socket.on('puzzle:error', (data) => { showBanner('⚠️ ' + data.message); setTimeout(hideBanner, 4000); });

    let wakeLock = null;
    let noSleepStarted = false;

    function startNoSleepFallback() {
      if (noSleepStarted) return;
      noSleepStarted = true;
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 2; canvas.height = 2;
        canvas.getContext('2d').fillRect(0, 0, 2, 2);
        const stream = canvas.captureStream(1);
        const video = document.createElement('video');
        video.muted = true;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('autoplay', '');
        video.style.cssText = 'position:fixed;bottom:0;right:0;width:1px;height:1px;opacity:0.01;pointer-events:none;';
        video.srcObject = stream;
        document.body.appendChild(video);
        video.play().catch(() => {});
      } catch (e) {
        console.error('⚠️ Fallback nahan layar gagal:', e.message);
      }
    }

    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLock = await navigator.wakeLock.request('screen');
          wakeLock.addEventListener('release', () => { wakeLock = null; });
          return;
        } catch (e) {
          console.error('⚠️ Wake Lock API gagal, pakai fallback:', e.message);
        }
      }
      startNoSleepFallback();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wakeLock === null) requestWakeLock();
    });

    requestWakeLock();

    document.body.addEventListener('click', function goFullscreen() {
      document.documentElement.requestFullscreen().catch(() => {});
      requestWakeLock();
      document.body.removeEventListener('click', goFullscreen);
    }, { once: true });
  </script>
  <script src="/shared/vote-overlay.js"></script>
</body>
</html>
