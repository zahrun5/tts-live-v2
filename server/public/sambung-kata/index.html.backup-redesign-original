<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sambung Kata Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1a1d2e">
<style>
  :root {
    --bg-deep: #1a1d2e;
    --panel: #252938;
    --panel-light: #2f3447;
    --accent: #9ca3d4;
    --accent-soft: rgba(156, 163, 212, 0.2);
    --gold: #d4b896;
    --silver: #b8bcc9;
    --bronze: #c4a68a;
    --text-primary: #d4d9e8;
    --text-muted: #8e95b3;
    --slot-bg: #2a2340;
    --slot-found: #1a3a2a;
    --slot-border: #3a3360;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    width: 100vw; height: 100vh;
    background: var(--bg-deep);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  #app {
    display: flex; flex-direction: column;
    width: 100vw; height: 100vh;
    padding: 3vh 3vw 2vh;
    gap: 1.6vh;
  }

  /* ===== Panel huruf dasar ===== */
  #letterPanel {
    flex: 0 0 auto;
    background: var(--panel);
    border-radius: 16px;
    padding: 10px 14px 12px;
    display: flex; flex-direction: column; align-items: center;
    gap: 6px;
  }
  #letterPanel .letterPanel-top {
    width: 100%; display: flex; align-items: center; justify-content: space-between;
  }
  #letterPanel .letterPanel-label {
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(9px, 2.2vw, 11px); color: var(--gold);
    background: rgba(212, 184, 150, 0.12);
    padding: 3px 9px; border-radius: 999px; letter-spacing: 0.4px;
  }
  #letterPanel .letterPanel-progress {
    font-family: 'Baloo 2', sans-serif; font-weight: 700;
    font-size: clamp(11px, 2.8vw, 14px); color: var(--text-primary);
  }
  #letterPanel .letterPanel-progress .num-solved { color: #7ec4a3; }
  #letterWheel {
    position: relative;
    width: min(30vh, 40vw); height: min(30vh, 40vw);
    margin: 4px 0 2px;
    border-radius: 50%;
    border: 4px solid var(--accent);
    background: radial-gradient(circle at center, rgba(47, 52, 71, 0.4) 0%, rgba(37, 41, 56, 0.8) 70%, rgba(26, 29, 46, 0.9) 100%);
    box-shadow: 0 0 20px rgba(156, 163, 212, 0.3), inset 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  #letterWheel .hub {
    position: absolute; top: 50%; left: 50%;
    width: 22%; height: 22%; transform: translate(-50%, -50%);
    border-radius: 50%; 
    background: var(--panel-light);
    border: 2px solid rgba(156, 163, 212, 0.25);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  .letter-bubble {
    position: absolute; top: 0; left: 0;
    width: 27%; height: 27%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(156, 163, 212, 0.3) 0%, rgba(47, 52, 71, 0.85) 100%);
    color: #e8e6f0;
    border: 2px solid var(--accent);
    border-radius: 50%;
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(16px, 4.5vw, 22px);
    box-shadow: 0 3px 8px rgba(0,0,0,0.3), inset 0 1px 2px rgba(255, 255, 255, 0.1);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  #letterPanel.done { background: #2a3832; }

  /* Avatar zone */
  #avatarZone {
    flex: 0 0 64px;
    position: relative;
    background: transparent;
    border-radius: 12px;
    overflow: visible;
    min-height: 64px;
  }
  .mini-avatar {
    position: absolute;
    bottom: 4px;
    display: flex; flex-direction: column; align-items: center;
    pointer-events: none;
    will-change: left;
  }
  .mini-avatar .emoji {
    display: block; font-size: 26px; line-height: 1;
    animation: avatarBob 0.5s ease-in-out infinite alternate;
  }
  .mini-avatar.facing-right .emoji { transform: scaleX(-1); }
  .mini-avatar .name-tag {
    font-family: 'Baloo 2', sans-serif; font-weight: 700; font-size: 8px;
    color: var(--text-primary); background: rgba(0,0,0,0.35);
    padding: 1px 6px; border-radius: 999px; margin-bottom: 2px;
    white-space: nowrap; max-width: 84px; overflow: hidden; text-overflow: ellipsis;
    order: -1;
  }
  .mini-avatar .comment-bubble {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 9.5px;
    color: #1a1d2e; background: #e8e6f0;
    padding: 3px 9px; border-radius: 10px; margin-bottom: 4px;
    white-space: nowrap; max-width: 150px; overflow: hidden; text-overflow: ellipsis;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    position: relative; order: -2;
  }
  .mini-avatar .comment-bubble::after {
    content: '';
    position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%);
    border-width: 4px 4px 0 4px; border-style: solid;
    border-color: #e8e6f0 transparent transparent transparent;
  }
  @keyframes avatarBob {
    from { transform: translateY(0); }
    to   { transform: translateY(-4px); }
  }

  /* Vote hint inline */
  #voteHintInline {
    overflow: hidden;
    white-space: nowrap;
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 3vw, 15px);
    font-weight: 600;
    color: var(--text-muted);
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    padding: 2px 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  }
  #voteHintInline b { color: var(--gold); font-weight: 800; }
  #voteHintInline .marquee-track {
    display: inline-block;
    padding-left: 100%;
    animation: marqueeScroll 20s linear infinite;
  }
  @keyframes marqueeScroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  /* Answer list area */
  #answerWrap {
    flex: 2; display: flex; align-items: flex-start; justify-content: center;
    min-height: 0; position: relative; padding-top: 0.5vh;
  }
  #answerList {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 12px;
    width: 100%;
    max-width: 620px;
  }
  .answer-slot {
    display: flex; align-items: center;
    background: var(--slot-bg);
    border: 2px solid var(--slot-border);
    border-radius: 10px;
    padding: 0;
    min-height: clamp(40px, 7vh, 56px);
    transition: all 0.4s cubic-bezier(.34,1.56,.64,1);
    overflow: hidden;
  }
  .answer-slot.found {
    background: var(--slot-found);
    border-color: #4ade80;
  }
  .slot-number {
    flex: 0 0 auto;
    width: clamp(32px, 5vw, 44px);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: clamp(14px, 3vw, 20px);
    color: var(--text-muted);
    background: rgba(0,0,0,0.15);
    align-self: stretch;
  }
  .answer-slot.found .slot-number { color: #4ade80; }
  .slot-content {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 6px 12px;
    font-family: 'Baloo 2', sans-serif; font-weight: 700;
    font-size: clamp(14px, 3.4vw, 20px);
    color: var(--text-muted);
    letter-spacing: 1px;
  }
  .answer-slot.found .slot-content {
    color: var(--text-primary);
    letter-spacing: 0.5px;
  }
  .slot-player {
    font-size: clamp(9px, 1.8vw, 11px);
    color: var(--accent);
    font-weight: 600;
    margin-left: 6px;
  }

  /* Slot reveal animation */
  .answer-slot.reveal {
    animation: slotReveal 0.5s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes slotReveal {
    0%   { transform: scaleY(0.3); opacity: 0.3; }
    50%  { transform: scaleY(1.08); }
    100% { transform: scaleY(1); opacity: 1; }
  }

  #toast {
    position: absolute; top: -6px; left: 50%;
    transform: translate(-50%, -130%);
    background: var(--accent); color: #1a1d2e;
    padding: 10px 18px; border-radius: 999px; font-weight: 700;
    font-size: clamp(12px, 3vw, 15px); white-space: nowrap;
    box-shadow: 0 4px 16px var(--accent-soft);
    opacity: 0; transition: transform .35s ease, opacity .35s ease;
    pointer-events: none; z-index: 5;
  }
  #toast.show { transform: translate(-50%, 0%); opacity: 1; }

  #leaderboard {
    position: absolute; top: 8px; right: 8px; z-index: 4;
    background: rgba(37, 41, 56, 0.92); border-radius: 12px;
    padding: 8px 10px; display: flex; flex-direction: column;
    min-width: 140px; max-width: 200px;
    max-height: 85vh;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(156, 163, 212, 0.2);
  }
  #leaderboard .label {
    font-family: 'Baloo 2', sans-serif; font-weight: 600;
    font-size: 10px; color: var(--gold);
    margin-bottom: 5px; display: flex; align-items: center; gap: 4px;
  }
  #lbList { 
    display: flex; flex-direction: column; gap: 3px; 
    overflow-y: auto; max-height: 75vh;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
  }
  #lbList::-webkit-scrollbar { width: 4px; }
  #lbList::-webkit-scrollbar-track { background: transparent; }
  #lbList::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }
  .lb-row { display: flex; align-items: center; gap: 6px; }
  .lb-rank {
    font-family: 'Baloo 2', sans-serif; font-weight: 800;
    font-size: 10px; width: 12px; text-align: center; color: var(--text-muted);
  }
  .lb-row:nth-child(1) .lb-rank { color: var(--gold); }
  .lb-row:nth-child(2) .lb-rank { color: var(--silver); }
  .lb-row:nth-child(3) .lb-rank { color: var(--bronze); }
  .lb-name { flex: 1; font-weight: 600; font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 20vw; }
  .lb-score { font-family: 'Baloo 2', sans-serif; font-weight: 700; color: var(--accent); font-size: 10.5px; }
  .empty-hint { color: var(--text-muted); font-size: 13px; text-align: center; padding-top: 10px; }

  #banner {
    position: fixed; bottom: 2vh; left: 50%; transform: translateX(-50%);
    background: var(--panel-light); border: 1px solid var(--accent);
    color: var(--text-primary); padding: 10px 20px; border-radius: 999px;
    font-size: 13px; font-weight: 600; display: none; z-index: 10;
  }
  #banner.show { display: block; }

  /* Responsive: Mobile 1 column */
  @media (max-width: 480px) {
    #answerList {
      grid-template-columns: 1fr;
      gap: 6px;
      max-width: 400px;
    }
  }

  /* Mode landscape */
  @media (orientation: landscape) {
    #app {
      display: grid;
      grid-template-columns: 1fr minmax(240px, 32%);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "letters letters"
        "avatars avatars"
        "answers answers";
      gap: 1.4vh 1.6vw;
      padding: 2vh 2.4vw;
    }
    #letterPanel { grid-area: letters; flex-direction: row; justify-content: space-between; }
    #letterWheel { width: min(16vh, 14vw); height: min(16vh, 14vw); margin: 0; }
    #avatarZone { grid-area: avatars; }
    #answerWrap { grid-area: answers; min-width: 0; }
  }
</style>
</head>
<body>
  <div id="app">
    <div id="letterPanel">
      <div class="letterPanel-top">
        <span class="letterPanel-label">HURUF DASAR</span>
        <span class="letterPanel-progress" id="progressText">Menunggu soal...</span>
      </div>
      <div id="letterWheel"><div class="hub"></div></div>
      <div id="voteHintInline"><div class="marquee-track">💬 Komen <b>SKIP 10x</b> rame-rame kalo kesulitan &nbsp;•&nbsp; ketik <b>GANTI 10x</b> buat ganti game &nbsp;•&nbsp; kalo kalian nggak bisa nerima kenyataan dari kekalahan, komen <b>NYERAH 10x</b> 🤣🤣🤣 niscaya aku kasih jawabannya</div></div>
    </div>

    <div id="avatarZone"></div>

    <div id="answerWrap">
      <div id="toast"></div>
      <div id="answerList"></div>
      <div id="leaderboard">
        <div class="label">🏆 Papan Juara</div>
        <div id="lbList"><div class="empty-hint">Belum ada yang jawab</div></div>
      </div>
    </div>
  </div>

  <div id="banner"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
  </script>
  <script src="/shared/v2-bootstrap.js"></script>
  <script src="/shared/game-switch-watcher.js"></script>
  <script>
    const answerListEl = document.getElementById('answerList');
    const answerWrap = document.getElementById('answerWrap');
    const toastEl = document.getElementById('toast');
    const letterPanelEl = document.getElementById('letterPanel');
    const letterWheelEl = document.getElementById('letterWheel');
    const progressTextEl = document.getElementById('progressText');
    const lbList = document.getElementById('lbList');
    const bannerEl = document.getElementById('banner');

    let currentPuzzle = null;
    let currentBaseLetters = null;
    let toastTimer = null;
    let prevAnswerStates = new Map();

    function renderAnswerList(data) {
      currentPuzzle = data;
      const { words } = data;

      answerListEl.innerHTML = '';

      words.forEach((w, idx) => {
        const slot = document.createElement('div');
        slot.className = 'answer-slot';
        const wordKey = `${w.number}-${w.direction}`;
        
        if (w.answer) {
          slot.classList.add('found');
          
          // Check if this is newly found
          if (!prevAnswerStates.has(wordKey)) {
            slot.classList.add('reveal');
          }
          prevAnswerStates.set(wordKey, true);
        }

        const numberEl = document.createElement('div');
        numberEl.className = 'slot-number';
        numberEl.textContent = w.number;

        const contentEl = document.createElement('div');
        contentEl.className = 'slot-content';
        
        if (w.answer) {
          contentEl.textContent = w.answer;
        } else {
          contentEl.textContent = '?'.repeat(w.length);
        }

        slot.appendChild(numberEl);
        slot.appendChild(contentEl);
        answerListEl.appendChild(slot);
      });
    }

    function renderLetterWheel(baseLetters) {
      if (currentBaseLetters === baseLetters) return;
      currentBaseLetters = baseLetters;

      letterWheelEl.innerHTML = '<div class="hub"></div>';
      if (!baseLetters) return;

      const letters = baseLetters.split('');
      const n = letters.length;
      const radius = 50 - 27 / 2;

      letters.forEach((ch, i) => {
        const angle = (2 * Math.PI * i / n) - Math.PI / 2;
        const cx = 50 + radius * Math.cos(angle);
        const cy = 50 + radius * Math.sin(angle);

        const bubble = document.createElement('div');
        bubble.className = 'letter-bubble';
        bubble.textContent = ch;
        bubble.style.left = `${cx}%`;
        bubble.style.top = `${cy}%`;
        bubble.style.transform = 'translate(-50%, -50%)';
        letterWheelEl.appendChild(bubble);
      });
    }

    function renderProgress(words) {
      const total = words.length;
      const solved = words.filter(w => w.answer).length;

      if (solved === total && total > 0) {
        letterPanelEl.classList.add('done');
        progressTextEl.innerHTML = '🎉 Semua kata ketemu!';
      } else {
        letterPanelEl.classList.remove('done');
        progressTextEl.innerHTML = `<span class="num-solved">${solved}</span> / ${total} kata`;
      }
    }

    function renderLeaderboard(list) {
      if (!list || list.length === 0) {
        lbList.innerHTML = '<div class="empty-hint">Belum ada yang jawab</div>';
        return;
      }
      lbList.innerHTML = list.slice(0, 10).map((row, i) => `
        <div class="lb-row">
          <span class="lb-rank">${i + 1}</span>
          <span class="lb-name">${escapeHtml(row.player)}</span>
          <span class="lb-score">${row.score}</span>
        </div>`).join('');
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function showToast(data) {
      toastEl.textContent = `${data.player} benar! ${data.answer ? data.answer.toUpperCase() : ''}`;
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3000);
    }

    function showBanner(text) { bannerEl.textContent = text; bannerEl.classList.add('show'); }
    function hideBanner() { bannerEl.classList.remove('show'); }

    const avatarZone = document.getElementById('avatarZone');
    const activeAvatars = {};

    function spawnAvatar(player, emoji, profileUrl, avatarType) {
      if (activeAvatars[player]) return;
      const el = document.createElement('div');
      el.className = 'mini-avatar';
      let avatarHtml = `<span class="emoji">${emoji}</span>`;
      if (avatarType === 'tiktok' && profileUrl) {
         avatarHtml = `<img src="${profileUrl}" onerror="this.outerHTML='<span class=\\'emoji\\'>${emoji}</span>'" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:2px;border:1px solid #fff;display:inline-block;vertical-align:middle;" />`;
      }
      el.innerHTML = `${avatarHtml}<span class="name-tag">${player}</span>`;
      avatarZone.appendChild(el);
      const startLeft = Math.random() * Math.max(0, avatarZone.clientWidth - 40);
      el.style.left = startLeft + 'px';
      activeAvatars[player] = { el, timer: null };
      walkRandomly(player);
    }

    function walkRandomly(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      const zoneWidth = avatarZone.clientWidth || 300;
      const avatarWidth = entry.el.offsetWidth || 40;
      const maxLeft = Math.max(0, zoneWidth - avatarWidth);
      const currentLeft = parseFloat(entry.el.style.left) || 0;
      const targetLeft = Math.random() * maxLeft;
      const duration = 2.5 + Math.random() * 3;
      entry.el.classList.toggle('facing-right', targetLeft > currentLeft);
      entry.el.style.transition = `left ${duration}s linear`;
      entry.el.style.left = targetLeft + 'px';
      entry.timer = setTimeout(() => walkRandomly(player), duration * 1000);
    }

    function showComment(player, text) {
      const entry = activeAvatars[player];
      if (!entry) return;
      let bubble = entry.el.querySelector('.comment-bubble');
      if (!bubble) {
        bubble = document.createElement('span');
        bubble.className = 'comment-bubble';
        entry.el.appendChild(bubble);
      }
      bubble.textContent = text;
      clearTimeout(entry.commentTimer);
      entry.commentTimer = setTimeout(() => bubble.remove(), 4000);
    }

    function clearAllAvatars() {
      Object.values(activeAvatars).forEach(({ el, timer, commentTimer }) => {
        clearTimeout(timer);
        clearTimeout(commentTimer);
        el.remove();
      });
      for (const key in activeAvatars) delete activeAvatars[key];
    }

    function removeAvatar(player) {
      const entry = activeAvatars[player];
      if (!entry) return;
      clearTimeout(entry.timer);
      clearTimeout(entry.commentTimer);
      entry.el.remove();
      delete activeAvatars[player];
    }

    socket.on('avatar:spawn', (data) => spawnAvatar(data.player, data.emoji, data.profileUrl, data.avatarType));
    socket.on('avatar:sync', (list) => { clearAllAvatars(); list.forEach((d) => spawnAvatar(d.player, d.emoji, d.profileUrl, d.avatarType)); });
    socket.on('avatar:reset', clearAllAvatars);
    socket.on('avatar:remove', ({ player }) => removeAvatar(player));
    socket.on('chat:comment', ({ player, text }) => showComment(player, text));

    socket.on('game:switched', () => window.location.reload());
    socket.on('update', (data) => {
      renderAnswerList(data);
      renderLetterWheel(data.baseLetters);
      renderProgress(data.words);
    });
    socket.on('answer:correct', (data) => showToast(data));
    socket.on('leaderboard:update', (list) => renderLeaderboard(list));
    socket.on('puzzle:completed', () => showBanner('🎉 Semua kata ketemu! Menyiapkan soal baru...'));
    socket.on('puzzle:new', () => { currentBaseLetters = null; prevAnswerStates.clear(); hideBanner(); });
    socket.on('puzzle:error', (data) => { showBanner('⚠️ ' + data.message); setTimeout(hideBanner, 4000); });

    let wakeLock = null;
    let noSleepStarted = false;

    function startNoSleepFallback() {
      if (noSleepStarted) return;
      noSleepStarted = true;
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 2; canvas.height = 2;
        canvas.getContext('2d').fillRect(0, 0, 2, 2);
        const stream = canvas.captureStream(1);
        const video = document.createElement('video');
        video.muted = true;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('autoplay', '');
        video.style.cssText = 'position:fixed;bottom:0;right:0;width:1px;height:1px;opacity:0.01;pointer-events:none;';
        video.srcObject = stream;
        document.body.appendChild(video);
        video.play().catch(() => {});
      } catch (e) {
        console.error('⚠️ Fallback nahan layar gagal:', e.message);
      }
    }

    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLock = await navigator.wakeLock.request('screen');
          wakeLock.addEventListener('release', () => { wakeLock = null; });
          return;
        } catch (e) {
          console.error('⚠️ Wake Lock API gagal, pakai fallback:', e.message);
        }
      }
      startNoSleepFallback();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wakeLock === null) requestWakeLock();
    });

    requestWakeLock();

    document.body.addEventListener('click', function goFullscreen() {
      document.documentElement.requestFullscreen().catch(() => {});
      requestWakeLock();
      document.body.removeEventListener('click', goFullscreen);
    }, { once: true });
  </script>
  <script src="/shared/vote-overlay.js"></script>
</body>
</html>
