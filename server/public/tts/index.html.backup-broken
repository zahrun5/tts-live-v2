<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TTS Live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0f0a1f">
<style>
:root{--bg-start:#0f0a1f;--bg-end:#1a0f2e;--glass-bg:rgba(255,255,255,0.05);--glass-border:rgba(255,255,255,0.1);--accent-purple:#8b5cf6;--accent-blue:#6366f1;--success:#10b981;--gold:#f59e0b;--text-primary:#f3f4f6;--text-muted:#9ca3af;--cell-bg:#f3f4f6}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Poppins',sans-serif;background:linear-gradient(135deg,var(--bg-start) 0%,var(--bg-end) 100%);color:var(--text-primary);overflow:hidden;height:100vh;position:relative}
body::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% 30%,rgba(139,92,246,0.15) 0%,transparent 50%),radial-gradient(circle at 80% 70%,rgba(99,102,241,0.15) 0%,transparent 50%);animation:bgShift 15s ease-in-out infinite;pointer-events:none}
@keyframes bgShift{0%,100%{opacity:0.8;transform:scale(1)}50%{opacity:1;transform:scale(1.1)}}
#app{height:100vh;display:flex;flex-direction:column;padding:2vh 2vw;gap:1.5vh;position:relative;z-index:1}
#activeClue{flex:0 0 auto;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-border);border-radius:16px;padding:0.8rem 1.2rem;display:flex;align-items:center;gap:0.8rem;box-shadow:0 8px 32px rgba(0,0,0,0.3);animation:fadeInDown 0.8s ease}
@keyframes fadeInDown{from{opacity:0;transform:translateY(-30px)}to{opacity:1;transform:translateY(0)}}
.activeClue-label{font-weight:800;font-size:clamp(0.65rem,1.6vw,0.85rem);background:linear-gradient(135deg,var(--gold),#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;padding:0.25rem 0.7rem;border-radius:50px;border:1px solid rgba(245,158,11,0.3);letter-spacing:0.5px;flex:0 0 auto}
.activeClue-no{font-weight:800;font-size:clamp(1rem,3vw,1.4rem);color:var(--text-primary);flex:0 0 auto}
.activeClue-dir{font-size:clamp(0.9rem,2.4vw,1.2rem);color:var(--text-muted);flex:0 0 auto}
.activeClue-text{font-weight:700;font-size:clamp(0.9rem,2.4vw,1.2rem);color:var(--text-primary);line-height:1.3;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#activeClue.done{background:rgba(16,185,129,0.15);border-color:rgba(16,185,129,0.3)}
#gridWrap{flex:2;display:flex;align-items:center;justify-content:center;min-height:0;position:relative}
#grid{display:grid;gap:2px;animation:fadeInUp 0.8s ease 0.2s both}
@keyframes fadeInUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.cell{position:relative;background:transparent}
.cell.open{background:var(--cell-bg);border-radius:3px;box-shadow:0 2px 8px rgba(0,0,0,0.2)}
.cell .num{position:absolute;top:2px;left:3px;font-size:0.26em;font-weight:700;color:var(--accent-purple);font-family:'Poppins',sans-serif}
.cell .letter{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-weight:700;color:#1a0f2e;font-size:0.55em}
#toast{position:absolute;top:-6px;left:50%;transform:translate(-50%,-130%);background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));color:white;padding:0.8rem 1.5rem;border-radius:50px;font-weight:700;font-size:clamp(0.9rem,2.5vw,1.2rem);white-space:nowrap;box-shadow:0 8px 32px rgba(139,92,246,0.5);opacity:0;transition:transform .35s ease,opacity .35s ease;pointer-events:none;z-index:5}
#toast.show{transform:translate(-50%,0%);opacity:1}
#tickerCard{flex:1.2;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-border);border-radius:16px;padding:1rem;display:flex;flex-direction:column;min-height:0;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.3)}
#tickerCard .label{font-weight:700;font-size:clamp(0.8rem,2vw,1rem);background:linear-gradient(135deg,var(--accent-purple),var(--accent-blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:0.7rem}
#clueColumns{flex:1;display:flex;gap:1rem;min-height:0}
.clue-col{flex:1;display:flex;flex-direction:column;min-width:0}
.clue-col .col-title{font-weight:700;letter-spacing:0.5px;font-size:clamp(0.75rem,1.9vw,0.95rem);color:var(--text-muted);margin-bottom:0.5rem;flex:0 0 auto;display:flex;align-items:center;gap:0.5rem}
.col-title .solved-count{font-weight:600;color:var(--success);letter-spacing:0;font-size:0.9em}
.col-list{flex:1;overflow:hidden;position:relative;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 8%,black 92%,transparent 100%);mask-image:linear-gradient(to bottom,transparent 0%,black 8%,black 92%,transparent 100%)}
.col-track{position:absolute;top:0;left:0;width:100%;display:flex;flex-direction:column;gap:0.5rem}
.col-track.scrolling{animation-name:colScroll;animation-timing-function:linear;animation-iteration-count:infinite}
@keyframes colScroll{from{transform:translateY(0)}to{transform:translateY(-50%)}}
.clue-row{display:flex;gap:0.6rem;align-items:flex-start;border-radius:8px;padding:0.5rem 0.7rem;font-size:clamp(0.8rem,2vw,1rem);line-height:1.3;background:rgba(245,158,11,0.15);color:var(--text-primary);font-weight:600;border:1px solid rgba(245,158,11,0.2)}
.clue-row.pending{background:rgba(245,158,11,0.15);color:var(--text-primary);font-weight:600}
.clue-row.pending .clue-no{color:var(--gold)}
.clue-row.solved{background:transparent;color:var(--text-muted);font-weight:500;opacity:0.5;text-decoration:line-through;text-decoration-thickness:1.5px}
.clue-row.solved .clue-no{color:var(--success);text-decoration:none}
.clue-row .clue-no{font-weight:800;flex:0 0 auto}
.clue-row .clue-check{flex:0 0 auto}
#leaderboard{position:absolute;top:8px;right:8px;z-index:10;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-border);border-radius:16px;padding:1rem;min-width:clamp(120px,16vw,180px);max-width:240px;box-shadow:0 8px 32px rgba(0,0,0,0.3);animation:slideInRight 0.8s ease 0.5s both}
@keyframes slideInRight{from{opacity:0;transform:translateX(50px)}to{opacity:1;transform:translateX(0)}}
.label{font-weight:700;font-size:clamp(0.75rem,1.7vw,0.9rem);background:linear-gradient(135deg,var(--gold),#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:0.7rem;display:flex;align-items:center;gap:0.3rem}
#lbList{display:flex;flex-direction:column;gap:0.4rem}
.lb-row{display:flex;align-items:center;gap:0.5rem;padding:0.35rem 0.5rem;background:rgba(255,255,255,0.03);border-radius:8px;transition:all 0.3s}
.lb-row:hover{background:rgba(255,255,255,0.08);transform:translateX(4px)}
.lb-rank{font-weight:800;font-size:clamp(0.7rem,1.6vw,0.85rem);width:clamp(16px,3.2vw,22px);text-align:center;color:var(--text-muted)}
.lb-row:nth-child(1) .lb-rank{background:linear-gradient(135deg,#fbbf24,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lb-row:nth-child(2) .lb-rank{background:linear-gradient(135deg,#e5e7eb,#9ca3af);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lb-row:nth-child(3) .lb-rank{background:linear-gradient(135deg,#d97706,#92400e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lb-name{flex:1;font-weight:600;font-size:clamp(0.65rem,1.5vw,0.8rem);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:20vw}
.lb-score{font-weight:700;font-size:clamp(0.65rem,1.5vw,0.8rem);color:var(--accent-purple)}
.empty-hint{color:var(--text-muted);font-size:clamp(0.8rem,1.8vw,1rem);text-align:center;padding:0.8rem 0}
#banner{position:fixed;bottom:2vh;left:50%;transform:translateX(-50%);background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-border);color:var(--text-primary);padding:0.8rem 1.5rem;border-radius:50px;font-size:clamp(0.85rem,2vw,1.1rem);font-weight:600;display:none;z-index:10;box-shadow:0 8px 32px rgba(0,0,0,0.3)}
#banner.show{display:block}
@media(orientation:landscape){#app{display:grid;grid-template-columns:1fr minmax(240px,32%);grid-template-rows:auto 1fr auto;grid-template-areas:"active active" "grid ticker" "avatars avatars";gap:1.4vh 1.6vw;padding:2vh 2.4vw}#activeClue{grid-area:active}#gridWrap{grid-area:grid;min-width:0}#tickerCard{grid-area:ticker;flex:unset;min-height:0}#clueColumns{flex-direction:column;gap:0.8rem}#avatarZone{grid-area:avatars}}
#avatarZone{flex:0 0 64px;position:relative;background:transparent;border-radius:12px;overflow:visible;min-height:64px}
.mini-avatar{position:absolute;bottom:4px;display:flex;flex-direction:column;align-items:center;pointer-events:none;will-change:left}
.mini-avatar .emoji{display:block;font-size:26px;line-height:1;animation:avatarBob 0.5s ease-in-out infinite alternate}
.mini-avatar.facing-left .emoji{transform:scaleX(-1)}
.mini-avatar .name-tag{font-weight:700;font-size:0.65rem;color:var(--text-primary);background:rgba(0,0,0,0.5);padding:0.1rem 0.5rem;border-radius:50px;margin-bottom:0.15rem;white-space:nowrap;max-width:84px;overflow:hidden;text-overflow:ellipsis;order:-1}
.mini-avatar .comment-bubble{font-weight:600;font-size:0.7rem;color:#0f0a1f;background:var(--text-primary);padding:0.25rem 0.6rem;border-radius:10px;margin-bottom:0.3rem;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis;box-shadow:0 2px 6px rgba(0,0,0,0.3);position:relative;order:-2}
.mini-avatar .comment-bubble::after{content:'';position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);border-width:4px 4px 0 4px;border-style:solid;border-color:var(--text-primary) transparent transparent transparent}
@keyframes avatarBob{from{transform:translateY(0)}to{transform:translateY(-4px)}}
</style>
</head>
<body>
<div id="app">
<div id="activeClue">
<span class="activeClue-label">SEDANG DICARI</span>
<span class="activeClue-no"></span>
<span class="activeClue-dir"></span>
<span class="activeClue-text">Menunggu soal...</span>
</div>
<div id="gridWrap">
<div id="toast"></div>
<div id="grid"></div>
<div id="leaderboard">
<div class="label">🏆 Leaderboard</div>
<div id="lbList"><div class="empty-hint">Belum ada</div></div>
</div>
</div>
<div id="tickerCard">
<div class="label">📋 Semua Pertanyaan</div>
<div id="clueColumns">
<div class="clue-col">
<div class="col-title">MENDATAR <span class="solved-count" id="acrossSolved"></span></div>
<div class="col-list" id="acrossList"><div class="col-track" id="acrossTrack"></div></div>
</div>
<div class="clue-col">
<div class="col-title">MENURUN <span class="solved-count" id="downSolved"></span></div>
<div class="col-list" id="downList"><div class="col-track" id="downTrack"></div></div>
</div>
</div>
</div>
<div id="avatarZone"></div>
</div>
<div id="banner"></div>
<script src="/socket.io/socket.io.js"></script>
<script>const socket=io();</script>
<script src="/shared/v2-bootstrap.js"></script>
<script src="/shared/game-switch-watcher.js"></script>
<script src="/shared/vote-overlay.js"></script>
<script>
const gridEl=document.getElementById('grid'),gridWrap=document.getElementById('gridWrap'),toastEl=document.getElementById('toast'),acrossListEl=document.getElementById('acrossList'),downListEl=document.getElementById('downList'),acrossTrackEl=document.getElementById('acrossTrack'),downTrackEl=document.getElementById('downTrack'),acrossSolvedEl=document.getElementById('acrossSolved'),downSolvedEl=document.getElementById('downSolved'),lbList=document.getElementById('lbList'),bannerEl=document.getElementById('banner'),activeClueEl=document.getElementById('activeClue'),activeClueNoEl=activeClueEl.querySelector('.activeClue-no'),activeClueDirEl=activeClueEl.querySelector('.activeClue-dir'),activeClueTextEl=activeClueEl.querySelector('.activeClue-text');
let currentPuzzle=null,toastTimer=null;
function buildCellMap(rows,cols,words){const map=Array.from({length:rows},()=>Array(cols).fill(null));words.forEach(w=>{for(let i=0;i<w.length;i++){const r=w.row+(w.direction==='down'?i:0),c=w.col+(w.direction==='across'?i:0);if(!map[r][c])map[r][c]={number:null,letter:''};if(i===0&&!map[r][c].number)map[r][c].number=w.number;if(w.answer)map[r][c].letter=w.answer[i]}});return map}
function renderGrid(data){currentPuzzle=data;const{rows,cols,words}=data,map=buildCellMap(rows,cols,words),cellSize=Math.floor(Math.min(gridWrap.clientWidth/cols,gridWrap.clientHeight/rows));gridEl.style.gridTemplateColumns=`repeat(${cols}, ${cellSize}px)`;gridEl.style.gridTemplateRows=`repeat(${rows}, ${cellSize}px)`;gridEl.style.fontSize=`${cellSize}px`;gridEl.innerHTML='';for(let r=0;r<rows;r++){for(let c=0;c<cols;c++){const cellData=map[r][c],div=document.createElement('div');div.className='cell'+(cellData?' open':'');if(cellData){if(cellData.number){const num=document.createElement('span');num.className='num';num.textContent=cellData.number;div.appendChild(num)}const letter=document.createElement('div');letter.className='letter';letter.textContent=cellData.letter||'';div.appendChild(letter)}gridEl.appendChild(div)}}}
function renderClueRow(w){return`<div class="clue-row pending"><span class="clue-no">${w.number}</span><span>${w.clue}</span></div>`}
function renderClueColumn(trackEl,listEl,items){const rowsHtml=items.map(renderClueRow).join('')||'<div class="empty-hint">Semua kejawab</div>';trackEl.classList.remove('scrolling');trackEl.style.animationDuration='';trackEl.innerHTML=rowsHtml;if(items.length===0)return;requestAnimationFrame(()=>{const overflow=trackEl.scrollHeight>listEl.clientHeight+4;if(overflow){trackEl.innerHTML=rowsHtml+rowsHtml;trackEl.style.animationDuration=`${Math.max(8,items.length*2.5)}s`;trackEl.classList.add('scrolling')}})}
function renderClueList(words){const across=words.filter(w=>w.direction==='across'),down=words.filter(w=>w.direction==='down'),acrossPending=across.filter(w=>!w.answer),downPending=down.filter(w=>!w.answer),acrossSolved=across.length-acrossPending.length,downSolved=down.length-downPending.length;acrossSolvedEl.textContent=acrossSolved?`${acrossSolved} terjawab ✓`:'';downSolvedEl.textContent=downSolved?`${downSolved} terjawab ✓`:'';renderClueColumn(acrossTrackEl,acrossListEl,acrossPending);renderClueColumn(downTrackEl,downListEl,downPending)}
function renderActiveClue(words){const unsolved=words.find(w=>!w.answer);if(!unsolved){activeClueEl.classList.add('done');activeClueNoEl.textContent='';activeClueDirEl.textContent='';activeClueTextEl.textContent='🎉 Semua pertanyaan terjawab!';return}activeClueEl.classList.remove('done');activeClueNoEl.textContent=unsolved.number;activeClueDirEl.textContent=unsolved.direction==='across'?'→':'↓';activeClueTextEl.textContent=unsolved.clue}
function renderLeaderboard(list){if(!list||list.length===0){lbList.innerHTML='<div class="empty-hint">Belum ada</div>';return}lbList.innerHTML=list.map((row,i)=>{const name=String(row.player).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));return`<div class="lb-row"><span class="lb-rank">${i+1}</span><span class="lb-name">${name}</span><span class="lb-score">${row.score}</span></div>`}).join('')}
function showToast(data){toastEl.textContent=`${data.player} benar! No.${data.number}: ${data.answer.toUpperCase()}`;toastEl.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toastEl.classList.remove('show'),3000)}
function showBanner(text){bannerEl.textContent=text;bannerEl.classList.add('show')}
function hideBanner(){bannerEl.classList.remove('show')}
socket.on('game:switched',()=>window.location.reload());
socket.on('update',data=>{renderGrid(data);renderClueList(data.words);renderActiveClue(data.words)});
socket.on('answer:correct',data=>showToast(data));
socket.on('leaderboard:update',list=>renderLeaderboard(list));
socket.on('puzzle:completed',()=>showBanner('🎉 Puzzle selesai! Menyiapkan soal baru...'));
socket.on('puzzle:new',()=>hideBanner());
socket.on('puzzle:error',data=>{showBanner('⚠️ '+data.message);setTimeout(hideBanner,4000)});
const avatarZone=document.getElementById('avatarZone'),activeAvatars={};
function spawnAvatar(player,emoji,profileUrl,avatarType){if(activeAvatars[player])return;const el=document.createElement('div');el.className='mini-avatar';let avatarHtml='<span class="emoji">'+emoji+'</span>';if(avatarType==='tiktok'&&profileUrl){avatarHtml='<img src="'+profileUrl+'" onerror="this.outerHTML='<span class=\'emoji\'>'+emoji+'</span>'" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:2px;border:1px solid #fff;display:inline-block;vertical-align:middle;" />'}el.innerHTML=avatarHtml+'<span class="name-tag">'+player+'</span>';avatarZone.appendChild(el);el.style.left=(Math.random()*Math.max(0,avatarZone.clientWidth-40))+'px';activeAvatars[player]={el,timer:null};walkRandomly(player)}
function walkRandomly(player){const entry=activeAvatars[player];if(!entry)return;const zoneWidth=avatarZone.clientWidth||300,avatarWidth=entry.el.offsetWidth||40,maxLeft=Math.max(0,zoneWidth-avatarWidth),currentLeft=parseFloat(entry.el.style.left)||0,targetLeft=Math.random()*maxLeft,duration=2.5+Math.random()*3;entry.el.classList.toggle('facing-left',targetLeft<currentLeft);entry.el.style.transition=`left ${duration}s linear`;entry.el.style.left=targetLeft+'px';entry.timer=setTimeout(()=>walkRandomly(player),duration*1000)}
function showComment(player,text){const entry=activeAvatars[player];if(!entry)return;let bubble=entry.el.querySelector('.comment-bubble');if(!bubble){bubble=document.createElement('span');bubble.className='comment-bubble';entry.el.appendChild(bubble)}bubble.textContent=text;clearTimeout(entry.commentTimer);entry.commentTimer=setTimeout(()=>bubble.remove(),4000)}
function clearAllAvatars(){Object.values(activeAvatars).forEach(({el,timer,commentTimer})=>{clearTimeout(timer);clearTimeout(commentTimer);el.remove()});for(const key in activeAvatars)delete activeAvatars[key]}
function removeAvatar(player){const entry=activeAvatars[player];if(!entry)return;clearTimeout(entry.timer);clearTimeout(entry.commentTimer);entry.el.remove();delete activeAvatars[player]}
socket.on('avatar:spawn',data=>spawnAvatar(data.player,data.emoji,data.profileUrl,data.avatarType));
socket.on('avatar:sync',list=>{clearAllAvatars();list.forEach(d=>spawnAvatar(d.player,d.emoji,d.profileUrl,d.avatarType))});
socket.on('avatar:reset',clearAllAvatars);
socket.on('avatar:remove',({player})=>removeAvatar(player));
socket.on('chat:comment',({player,text})=>showComment(player,text));
window.addEventListener('resize',()=>{if(!currentPuzzle)return;renderGrid(currentPuzzle);renderClueList(currentPuzzle.words)});
let wakeLock=null;
async function requestWakeLock(){if('wakeLock'in navigator){try{wakeLock=await navigator.wakeLock.request('screen');wakeLock.addEventListener('release',()=>{wakeLock=null})}catch(e){}}}
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&wakeLock===null)requestWakeLock()});
requestWakeLock();
document.body.addEventListener('click',function goFullscreen(){document.documentElement.requestFullscreen().catch(()=>{});requestWakeLock();document.body.removeEventListener('click',goFullscreen)},{once:true});
</script>
</body>
</html>